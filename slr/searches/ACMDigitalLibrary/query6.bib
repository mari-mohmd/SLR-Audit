@inproceedings{10.1145/3772363.3798418,
author = {Wei, Bob Tianqi and Garanganao Almeda, Shm and Shen, Shayne and Tam, Ethan and Abrahamson, Dor},
title = {Sympathetic Orchestra: A Responsive Virtual Orchestra for Embodied Interpretive Practice in Conducting},
year = {2026},
