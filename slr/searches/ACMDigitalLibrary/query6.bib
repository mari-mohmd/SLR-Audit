@inproceedings{10.1145/3785987.3786050,
author = {Li, Jinhu and Lu, Wei and Li, Jinliang and Zhang, Qingsong},
title = {A Six-Dimensional Integrated Teaching Concept for Fire Engineering Courses in the Context of Artificial Intelligence},
year = {2026},
isbn = {9798400720956},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3785987.3786050},
doi = {10.1145/3785987.3786050},
abstract = {Currently, traditional fire protection engineering courses are plagued by three major pain points: difficulty in reproducing fire scenes, weak interaction between teachers and students in the classroom, and poor timeliness of classroom evaluation. These issues directly result in low student motivation and limited practical skills. The breakthrough development of artificial intelligence has made innovative teaching in the fire protection engineering major possible. This paper proposes to construct a new smart teaching model integrating six dimensions: " Intelligent Questioning - learning first, then teaching - VR immersion - problem-driven - AI evaluation - Intelligent Feedback ". By formulating training courses that adapt to the era of artificial intelligence and increasing the integration of professional courses such as artificial intelligence; Relying on online public classrooms such as knowledge graph platforms, "MOOCs" and "Artificial Intelligence +", micro-lessons are precisely pushed and data such as students' learning duration and focus points are collected. Develop a professional classroom service system using Python+MySQL to realize functions such as classroom grouping, sign-in, answering questions, and statistics. With the help of VR laboratories, the evolution of fires, the spread of smoke flows, fire fighting and disaster relief, as well as disaster avoidance routes can be restored. Taking real disaster cases generated by AI as anchor points, set up professional questions and organize PBL group discussions. Fully electronic homework, AI automatic scoring + teacher review, to achieve real-time updates of the knowledge graph. The deep integration of artificial intelligence with fire protection professional courses can significantly enhance the adaptability of professional knowledge and skills to the industry, and cultivate high-quality talents for fire protection engineering.},
booktitle = {Proceedings of the 2025 2nd International Conference on Artificial Intelligence and Future Education},
pages = {385–389},
numpages = {5},
location = {
},
series = {AIFE '25}
}

@inproceedings{10.1145/195473.195504,
author = {Schmidt, William J. and Nilsen, Kelvin D.},
title = {Performance of a hardware-assisted real-time garbage collector},
year = {1994},
isbn = {0897916603},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/195473.195504},
doi = {10.1145/195473.195504},
abstract = {Hardware-assisted real-time garbage collection offers high throughput and small worst-case bounds on the times required to allocate dynamic objects and to access the memory contained within previously allocated objects. Whether the proposed technology is cost effective depends on various choices between configuration alternatives. This paper reports the performance of several different configurations of the hardware-assisted real-time garbage collection system subjected to several different workloads. Reported measurements demonstrate that hardware-assisted real-time garbage collection is a viable alternative to traditional explicit memory management techniques, even for low-level languages like C++.},
booktitle = {Proceedings of the Sixth International Conference on Architectural Support for Programming Languages and Operating Systems},
pages = {76–85},
numpages = {10},
location = {San Jose, California, USA},
series = {ASPLOS VI}
}

@inproceedings{10.1145/3746058.3758472,
author = {Arakawa, Riku and Li, Franklin Mingzhe and Zhang, Nandi and Huh, Mina and Pavel, Amy and Suzuki, Ryo and Carrington, Patrick and Yan, Yukang},
