@inproceedings{10.1145/3715669.3727350,
author = {Crafa, Daniele Maria and Polonelli, Tommaso and Pezzoli, Carlo and Carminati, Marco and Magno, Michele},
title = {A Low-Power, Non-Invasive and Contactless Eye Blink Detection Sensor Enabling Human-Machine Interfaces for Smart Eyewear Applications},
