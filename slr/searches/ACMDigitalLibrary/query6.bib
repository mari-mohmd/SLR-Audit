url = {https://doi.org/10.1145/3799825.3818717},
doi = {10.1145/3799825.3818717},
abstract = {INK SONATA explores cross-cultural artistic translation between Western piano music and Chinese calligraphy through an emotion-driven interactive framework. By combining semantic generation, character stylization, and real-time mapping, the system transforms expressive piano performance into dynamic calligraphy. The project reimagines calligraphy as a performative medium and AI as a mediator of artistic understanding across cultures.},
