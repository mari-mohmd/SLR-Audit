@inproceedings{10.1145/3788851.3805008,
author = {Belz, Jan Henry and Avadieva, Raisa and Rukzio, Enrico and Grosse-Puppendahl, Tobias},
title = {GenX: Device Orchestration for Multimodal Generative Experiences in Ubiquitous Systems},
year = {2026},
isbn = {9798400724480},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788851.3805008},
doi = {10.1145/3788851.3805008},
abstract = {Device orchestration in ubiquitous computing remains cumbersome and highly static, particularly given the growing number of personal devices. Routine tasks, such as preparing to read at home, often require multiple manual interactions (lighting, heating, music), which are difficult to automate with rule-based systems due to contextual sensitivity. We present GenX, a perception-driven approach that applies multimodal generative AI to create dynamic, adaptive user experiences. By leveraging vision-language models, GenX interprets a user’s perception of their environment and generates a multimodal UX tailored to available output modalities. The system produces and executes source code in real time, enabling devices to be orchestrated flexibly and contextually. We introduce the concept of Generative Experiences as a scalable solution for dynamic UX design, capable of handling unexpected situations. GenX is demonstrated in two in-the-wild scenarios and a user study, showing positive user perceptions and effectiveness in supporting everyday tasks.},
booktitle = {Proceedings of the 2026 ACM International Conference on Interactive Media Experiences},
pages = {346–362},
numpages = {17},
keywords = {Ubiquitous Computing, Generative AI, Multimodal Interfaces},
location = {
},
series = {IMX '26}
}

@inproceedings{10.1145/1967677.1967695,
author = {Cullmann, Christoph},
title = {Cache persistence analysis: a novel approachtheory and practice},
year = {2011},
isbn = {9781450305556},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/1967677.1967695},
doi = {10.1145/1967677.1967695},
abstract = {To compute a worst-case execution time (WCET) estimate for a program, the architectural effects of the underlying hardware must be modeled. For modern processors this results in the need for a cache and pipeline analysis. The timing-relevant result of the cache analysis is the categorization of the accesses to cached memory. Categorizations that are obtainable by the well-known must and may cache analysis are always-hit, always-miss and not-classified. The cache persistence analysis tries to provide additional information for the not-classified case to limit the number of misses. There exists a cache persistence analysis by Ferdinand and Wilhelm based on abstract interpretation computing these classifications. In this paper, we present a correctness issue with this analysis and a novel analysis that fixes it. For fully timing compositional architectures the persistence information is straightforward to use. We will focus on the application of the persistence analysis for state-of-the-art architectures that show timing anomalies. Such architectures do not allow to quantify the costs of a single cache hit or miss in isolation. To make the usage of the persistence information feasible, we integrate the novel persistence analysis together with a novel path analysis approach into the industrially used WCET analyzer aiT.},
booktitle = {Proceedings of the 2011 SIGPLAN/SIGBED Conference on Languages, Compilers and Tools for Embedded Systems},
pages = {121–130},
numpages = {10},
keywords = {cache, persistence, wcet},
location = {Chicago, IL, USA},
series = {LCTES '11}
}

@article{10.1145/3794859,
author = {Alessi, Gaetano and Fugini, Mariagrazia},
title = {Adaptive Real-Time Financial Fraud Detection with Explainable AI&nbsp;Tools},
year = {2026},
issue_date = {March 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {7},
number = {1},
url = {https://doi.org/10.1145/3794859},
doi = {10.1145/3794859},
abstract = {Financial crime is increasingly facilitated by technology and globalization, demanding advanced IT tools for detection. The Fraud Detection System proposed in this article is devised to operate under pragmatic operational constraints inherent to financial institutions, such as extreme class imbalance, due to the rarity of fraudulent events, or the continuously evolving fraud patterns (concept drift) driven by adversarial adaptation, and, most significant, the stochastic delays in obtaining verified feedback, crucial for model supervision. This research develops financial transaction monitoring in a data stream context; it details a developed streaming Machine Learning (ML) pipeline, designed with a lightweight yet powerful Data Stream Management System (DSMS) for real-time feature engineering, and a multi-stage analytical engine that orchestrates diverse detection logic. This engine integrates deterministic rules with adaptive ML models and is coupled with a dynamic decision threshold management system to optimize the precision–recall tradeoff under operational pressures. A core contribution is the systematic, empirical comparison of diverse adaptive learning strategies, ranging from instance-incremental to various batch-incremental methods, to assess their adaptability and effectiveness under these operational conditions. Furthermore, the article describes an actionable interpretability framework designed to synthesize low-level feature attributions into user-centric concept importances, enhancing the utilities at the disposal of investigators.},
journal = {Digital Threats},
month = mar,
articleno = {7},
numpages = {31},
keywords = {Real-time Fraud Detection, Adaptive Machine Learning, Streaming Data Processing, Delayed Feedback, Concept Drift, Dynamic Threshold Management, Model Interpretability, Financial Crime}
}

@inproceedings{10.1145/3809986.3810053,
author = {Liu, Pengcheng},
title = {Construction of a Postoperative Recurrence Prediction Model for Thyroid Cancer Using Interpretable Machine Learning and Counterfactual Inference},
year = {2026},
isbn = {9798400721946},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3809986.3810053},
doi = {10.1145/3809986.3810053},
abstract = {Postoperative recurrence critically impacts long-term survival in thyroid cancer patients, necessitating early risk identification. Conventional statistical models are limited by linear assumptions and poor feature interaction capture, whereas machine learning approaches often operate as non-interpretable black boxes despite superior performance. This study developed a recurrence prediction framework using structured clinical data, optimizing six machine learning algorithms via random search cross-validation with all 16 clinical features. Random Forest achieved optimal performance with 96.1% accuracy, 98.8% AUROC, 100% precision, and 86.4% recall. SHAP analysis identified treatment response, risk stratification, and lymph node staging as key predictors, quantifying individual contributions, while DiCE generated actionable pathways for misclassified cases. A Streamlit-based interactive application facilitated clinical integration through real-time prediction and visualization. These findings demonstrate the potential of integrating high-performance modeling with transparent interpretability for precision medicine in thyroid cancer.},
booktitle = {Proceedings of the 2026 6th International Conference on Bioinformatics and Intelligent Computing},
pages = {439–444},
numpages = {6},
keywords = {DiCE, Explainable artificial intelligence, Machine learning, SHAP, Thyroid cancer, postoperative recurrence},
location = {
},
series = {BIC '26}
}

@inproceedings{10.1145/3788112.3788133,
author = {Li, Xinyu},
title = {AI-Based Personalized Correction for Refractive Errors through Integration with Refractive Surgery},
year = {2026},
isbn = {9798400718472},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788112.3788133},
doi = {10.1145/3788112.3788133},
abstract = {Artificial Intelligence (AI) in refractive surgery is changing the experience of surgery and improving postoperative management with the possibility of advice in real time. Intraoperatively, segmentation networks and tracking networks automatically recognize corneal landmarks with reinforcement learning and in real time make sure that ablation and scanning systems are micrometrically precise. Control by voice and augmented reality will allow the use of the display of various important parameters in the microscope view without interrupting sterile technique and automated checks of safety will decrease the incidence of near misses. In the postoperative phase, predictive models based on the correlative data of the intra-operative parameters with optical coherence tomography (OCT) or imaging may allow for an assessment of the results of the final refraction, time for recovering vision, corneal stability and in the relevant cases vault for ICL. It is also possible with these systems to assess haze and inflammation, and dry eye or delayed epithelial healing as well as being prognostic by means of a mix of tear-film imaging, temperature maps and patient reported outcomes data. Follow-up applications based on large language models provide reminders, analyze patient uploads, and flag aberrant trends, thereby improving adherence and facilitating earlier review. Hybrid systems which read both images and text provide a more complete picture of recovery. Reliable results depend on careful preprocessing, cross-site validation, transfer learning methods for small data sets, and federated learning techniques for preservation of anonymity. Explainability techniques and documentation increase clinician trust and lower regulatory hurdles. Clinical decision-support systems integrate all these together with the electronic record to provide transparent recommendations while keeping the physician in control of management. Problems still remain such as data heterogeneity, fairness, and continuous monitoring. In conclusion, AI provides a safe and interpretable foundation for closed-loop refractive care from the surgical suite through the follow-up stage.},
booktitle = {Proceedings of the 2025 2nd International Conference on Smart Healthcare and Wearable Intelligent Devices},
pages = {137–143},
numpages = {7},
keywords = {Artificial intelligence, Clinical decision support, Deep learning, Postoperative management, Refractive surgery},
location = {
},
series = {SHWID '25}
}

@inproceedings{10.1145/3801438.3801703,
author = {Liu, Buwei},
title = {Data-Driven Budget Control and Dynamic Early-Warning for Financial Management Workflows},
year = {2026},
isbn = {9798400721557},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3801438.3801703},
doi = {10.1145/3801438.3801703},
abstract = {Budget execution monitoring in complex financial workflows requires reliable early-warning mechanisms under streaming data and non-stationary distribution shifts. However, traditional rule-based control systems struggle to maintain stability and interpretability when budget flows exhibit temporal drift and structural irregularities. To address this challenge, we propose a streaming budget early-warning framework that integrates time-series forecasting, residual-driven concept drift detection, bounded parameter adaptation, and conformal uncertainty calibration into a unified computational pipeline. The proposed method models dynamic expenditure patterns, detects structural deviations in real time, and generates calibrated risk intervals to support decision-aware budget supervision. Extensive experiments on publicly released financial execution data demonstrate improved robustness under distribution shift, faster post-drift recovery, and reduced false alert rates compared with passive forecasting baselines. The results indicate that combining drift-aware updating with uncertainty calibration provides a stable and interpretable solution for streaming financial workflow monitoring.},
booktitle = {Proceedings of the 3rd International Conference on Machine Intelligence and Digital Applications},
pages = {1603–1610},
numpages = {8},
keywords = {Concept drift detection, Conformal prediction, Streaming budget monitoring, Time-series forecasting, Workflow risk modeling},
location = {
},
series = {MIDA 2026}
}

@inproceedings{10.1145/3706598.3713631,
author = {Dementyev, Artem and Kanevsky, Dimitri and Yang, Samuel and Parvaix, Mathieu and Lai, Chiong and Olwal, Alex},
title = {SpeechCompass: Enhancing Mobile Captioning with Diarization and Directional Guidance via Multi-Microphone Localization},
year = {2025},
isbn = {9798400713941},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3706598.3713631},
doi = {10.1145/3706598.3713631},
abstract = {Speech-to-text capabilities on mobile devices have proven helpful for hearing and speech accessibility, language translation, note-taking, and meeting transcripts. However, our foundational large-scale survey (n=263) shows that the inability to distinguish and indicate speaker direction makes them challenging in group conversations. SpeechCompass addresses this limitation through real-time, multi-microphone speech localization, where the direction of speech allows visual separation and guidance (e.g., arrows) in the user interface. We introduce efficient real-time audio localization algorithms and custom sound perception hardware, running on a low-power microcontroller with four integrated microphones, which we characterize in technical evaluations. Informed by a large-scale survey (n=494), we conducted an in-person study of group conversations with eight frequent users of mobile speech-to-text, who provided feedback on five visualization styles. The value of diarization and visualizing localization was consistent across participants, with everyone agreeing on the value and potential of directional guidance for group conversations.},
booktitle = {Proceedings of the 2025 CHI Conference on Human Factors in Computing Systems},
articleno = {73},
numpages = {17},
keywords = {Assistive technology, hearing accessibility, localization, diarization, microphone array, captioning},
location = {
},
series = {CHI '25}
}

@inproceedings{10.1145/3772363.3799279,
author = {Zhou, Shaoze and Nelly Rivera Rodriguez, ⁠Diana and Remior, Pedro and Frangi, Joaquin and Li, Lingyao and Ma, Renkai and Johnson, Janet G. and Lisetti, Christine and Chen, Chen},
title = {Exploring Needs and Design Opportunities for Proactive Information Support in In-Person Small-Group Conversations},
year = {2026},
isbn = {9798400722813},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3772363.3799279},
doi = {10.1145/3772363.3799279},
abstract = {In-person small-group conversations play a crucial role in everyday life; however, facilitating effective group interaction can be challenging, as the real-time nature demands full attention, offers no opportunity for revision, and requires interpreting non-verbal cues. Using Mixed Reality to provide proactive information support shows promise in helping individuals engage in and contribute to group conversations. We present a preliminary participatory design and qualitative study (N = 10) using focus groups and two technology probes to explore the opportunities of designing proactive information support in in-person small-group conversations. We reveal key design opportunities concerning how to maximize the benefits of proactive information support and how to effectively design such supporting information. Our study is crucial for paving the way toward designing future proactive AI agents to enable the paradigm of augmented in-person small-group conversation experience.},
booktitle = {Proceedings of the Extended Abstracts of the 2026 CHI Conference on Human Factors in Computing Systems},
articleno = {274},
numpages = {7},
keywords = {Proactive AI, In-Person Group Conversation, Mixed Reality, Real-Time Conversation Support},
location = {
},
series = {CHI EA '26}
}

@inproceedings{10.1145/3610548.3618213,
author = {Fink, Laura and R{\"u}ckert, Darius and Franke, Linus and Keinert, Joachim and Stamminger, Marc},
title = {LiveNVS: Neural View Synthesis on Live RGB-D Streams},
year = {2023},
isbn = {9798400703157},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3610548.3618213},
doi = {10.1145/3610548.3618213},
abstract = {Existing real-time RGB-D reconstruction approaches, like Kinect Fusion, lack real-time photo-realistic visualization. This is due to noisy, oversmoothed or incomplete geometry and blurry textures which are fused from imperfect depth maps and camera poses. Recent neural rendering methods can overcome many of such artifacts but are mostly optimized for offline usage, hindering the integration into a live reconstruction pipeline. In this paper, we present LiveNVS, a system that allows for neural novel view synthesis on a live RGB-D input stream with very low latency and real-time rendering. Based on the RGB-D input stream, novel views are rendered by projecting neural features into the target view via a densely fused depth map and aggregating the features in image-space to a target feature map. A generalizable neural network then translates the target feature map into a high-quality RGB image. LiveNVS achieves state-of-the-art neural rendering quality of unknown scenes during capturing, allowing users to virtually explore the scene and assess reconstruction quality in real-time.},
booktitle = {SIGGRAPH Asia 2023 Conference Papers},
articleno = {37},
numpages = {11},
keywords = {Live preview, Neural rendering, Novel view synthesis, RGB-D Stream},
location = {Sydney, NSW, Australia},
series = {SA '23}
}

@inproceedings{10.1145/3689050.3704800,
author = {Piao, Ziyue},
title = {Exploring Haptics to Augment Kinesthetic Learning in Singing},
year = {2025},
isbn = {9798400711978},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
