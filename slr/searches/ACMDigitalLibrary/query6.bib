series = {ICBDT '22}
}

@inproceedings{10.1145/3786484.3786486,
author = {Cai, Chengcheng and Xia, Xudong and Tan, Yonglin and Wu, Yuhe and Xiang, Jie and Sun, Lingcui and Wang, Mengjun and Zhu, Shiyu},
title = {Towards Knowledge-Guided Multimodal Agents for Interpretable Plant Health Diagnostics},
year = {2026},
isbn = {9798400721267},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786484.3786486},
doi = {10.1145/3786484.3786486},
abstract = {Diagnosing plant diseases in real-world environments is challenging due to heterogeneous imaging conditions, environmental variability, and the limited interpretability of conventional deep models. We propose a collaborative multimodal intelligence framework integrating vision–language modeling, environmental sensing, and structured knowledge reasoning for plant pest and disease identification. The system adopts a multi-agent architecture forming a closed-loop workflow of perception, inference, and management, where specialized agents conduct feature extraction, context-aware reasoning, and decision fusion. A knowledge-distilled lightweight model supports on-device deployment within a WeChat Mini Program, enabling real-time diagnosis with minimal accuracy loss. Experiments in complex home-gardening scenarios achieve 54.5% overall diagnostic accuracy, outperforming single-modality baselines by 18.5%, especially under low-light and occluded conditions. This work presents an interpretable and scalable paradigm for knowledge-guided multimodal reasoning in intelligent horticulture, strengthening the connection between scientific diagnosis and practical application.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence and Sustainable Development},
pages = {8–12},
numpages = {5},
keywords = {Multimodal learning, Plant disease diagnosis, Vision–language model, Knowledge distillation, Intelligent horticulture},
location = {
},
series = {ICAISD '25}
}

@article{3512469.3512484,
author = {Chen, Xuguang},
title = {An introduction to MPI for Python},
year = {2021},
issue_date = {October 2021},
publisher = {Consortium for Computing Sciences in Colleges},
address = {Evansville, IN, USA},
volume = {37},
number = {1},
issn = {1937-4771},
abstract = {Because parallel computing has many potential applications, such as databases and data mining, real time simulation of systems, and advanced graphics, it is becoming more and more important. There are two widely known parallel programming models today: message-passing model and shared memory model. In the message-passing model, each task has its private memories, and different tasks can communicate each other via message exchanges. Message Passing Interface (MPI) is a specification designed by a group of researchers from academia and industry and primarily addressing the message-passing model. It specifies the syntax and semantics of a core of library routines useful for message-passing programs and can be implemented in different programming languages, for example, C, Fortran, Java, and Python.},
journal = {J. Comput. Sci. Coll.},
month = oct,
pages = {128–129},
numpages = {2}
}

@inproceedings{10.1145/3784013.3784014,
author = {Tian, Yuanxing and Zhang, Lixing and Chang, Feng and Wang, Ning and Su, Baoding and Gu, Zonglin},
title = {A deep reasoning large language model designed for troubleshooting faults in wind turbine generators},
year = {2026},
isbn = {9798400720185},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3784013.3784014},
doi = {10.1145/3784013.3784014},
abstract = {Wind power generation systems are structurally complex and operate in uncertain environments, resulting in diverse fault patterns and significant diagnostic challenges. Traditional rule-based expert systems and deep learning methods struggle with long-tail fault detection, limited generalization, and insufficient real-time knowledge updates. To address these issues, this paper introduces a three-stage fault detection framework based on Large Reasoning Models (LRMs). In the first stage, LRMs extract operational features and conduct anomaly detection for preliminary fault classification. In the second stage, the Retrieval-Augmented Generation (RAG) mechanism supports fault pattern reasoning and verification by supplementing missing information. In the final stage, targeted maintenance strategies and preventive plans are generated to enhance system stability and reliability. Experimental results demonstrate that the proposed method achieves high diagnostic accuracy and interpretability, providing an intelligent and efficient solution for wind power operation and maintenance.},
booktitle = {Proceedings of the 2025 2nd Symposium on Big Data, Neural Networks, and Deep Learning},
pages = {1–8},
numpages = {8},
keywords = {Intelligent Maintenance and Optimization, Large Reasoning Models, Retrieval-Augmented Generation, Wind Power Fault Diagnosis},
location = {
},
series = {BDNNDL '25}
}

@inproceedings{3721488.3721728,
author = {Schirmer, Fabian and Kranz, Philipp and Rose, Chad G. and Willert, Volker and Schmitt, Jan and Kaupp, Tobias},
title = {Utilizing Eye Gaze for Human-Robot Collaborative Assembly},
year = {2025},
publisher = {IEEE Press},
abstract = {Human-Robot Collaboration (HRC) in dynamic assembly environments requires intuitive communication for seamless interactions. Eye gaze, a nonverbal cue, is critical for interpreting human intent and enhancing robot adaptability. This research introduces a three-tier framework categorizing eye gaze into fixation, scanning, and task-switching behaviors, aiming to improve real-time robot responsiveness. Preliminary evaluations with multiple human subjects demonstrated the potential of this classification to enhance task alignment and detect anomalies in human behavior. Future work will explore automated personalization of the algorithm for individuals and integrate multimodal data to refine adaptability in human-robot collaborative systems.},
booktitle = {Proceedings of the 2025 ACM/IEEE International Conference on Human-Robot Interaction},
pages = {1603–1607},
numpages = {5},
keywords = {eye gaze classification, gaze interpretation, human-robot collaboration (hrc), nonverbal communication},
location = {Melbourne, Australia},
series = {HRI '25}
}

@inproceedings{10.1145/3801359.3801380,
author = {Li, Xiaolei and Wu, Xueyuan and Hu, Bo},
title = {Research on Intelligent Pricing Algorithm and Strategy of Food Safety Liability Insurance},
year = {2026},
isbn = {9798400722158},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3801359.3801380},
doi = {10.1145/3801359.3801380},
abstract = {With the continuous increase in food safety risks, the precise pricing of liability insurance based on big data and artificial intelligence has become a hot topic. This study, based on the existing “Food Safety Shield” blockchain traceability platform and its RISM-ICEI-Action algorithm, introduces cutting-edge technologies such as causal inference, deep reinforcement learning, and hybrid neural networks, and proposes a new intelligent pricing algorithm and strategy. The proposed solution enhances causality and interpretability through causal modeling, realizes real-time dynamic adjustment through deep reinforcement learning, and enhances the system's feasibility. Empirical results show that the new algorithm outperforms the traditional solution in terms of risk assessment accuracy (AUC), claim ratio, user satisfaction, and claim handling time. The algorithm framework achieves a paradigm shift from “correlation modeling” to “causal decision-making”. This method demonstrates the feasibility and superiority of the intelligent pricing framework based on blockchain + big data + AI in the field of food safety liability insurance, providing technical references for subsequent research and practice.},
booktitle = {Proceedings of the 2026 2nd International Conference on Big Data, Communication Technology and Computer Applications},
pages = {124–129},
numpages = {6},
keywords = {Food safety liability insurance, RISM-ICEI-Action framework, big data, blockchain, causal decision-making, causal inference, graph neural network, intelligent pricing, reinforcement learning},
location = {
},
series = {BDCTA '26}
}

@inproceedings{10.1145/3520084.3520085,
author = {Netinant, Paniti and Tuaktao, Yannakorn and Rukhiran, Meennapa},
title = {Development of Real-Time Hand Gesture for Volume Control Application using Python on Raspberry Pi},
year = {2022},
isbn = {9781450395519},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3520084.3520085},
doi = {10.1145/3520084.3520085},
abstract = {Computer interaction is one of the significant challenges that elderly and disabled people face in today's computerized world. In recent years, hand gesture recognition has emerged as one of the most natural human-machine interactions in software development, particularly for facilitating friendly and flexible human-computer interaction. This article proposed a system architecture and software configuration for developing a real-time volume control hand gesture on a Raspberry Pi equipped with a camera programmed in Python using the Open-Source Computer Vision (OpenCV) library. The hand gesture recognition system's primary objective is to establish communication between humans and computerized systems in order to control volume. According to the experimental results, the hand gesture recognition system performs well when controlling volume. The system is capable of operating in real-time for any individual.},
booktitle = {Proceedings of the 2022 5th International Conference on Software Engineering and Information Management},
pages = {1–5},
numpages = {5},
location = {Yokohama, Japan},
series = {ICSIM '22}
}

@article{10.1145/3757926,
author = {Bhatia, Munish},
title = {Cognitive Decision Modeling for Quality of Service in Domestic Pipeline Network},
year = {2025},
issue_date = {October 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {16},
number = {5},
issn = {2157-6904},
url = {https://doi.org/10.1145/3757926},
doi = {10.1145/3757926},
abstract = {The Internet of Things (IoT) has transformed the industrial sector. This study presents a novel framework for real-time evaluation of service quality in residential gas pipeline networks. IoT devices collect critical operational and environmental data, which are processed through a fog-cloud architecture using Bayesian modeling. This enables the calculation of a comprehensive Quality of Service Measure (QSM) and a Service Quality Delivery Value (SQDV) to assess and interpret service performance. A two-level decision-tree model further supports decisions by regulators and end-users. The framework was validated using 73,462 service interaction records, showing significant improvements over existing approaches: reduced data delay (179.01 s), high classification performance (Specificity: 94.22%, Sensitivity: 92.78%, Precision: 93.15%), enhanced decision-making (Accuracy: 95.45%, Error Rate: 1.29%), improved reliability (93.69%), and robust system stability (73.25%).},
journal = {ACM Trans. Intell. Syst. Technol.},
month = sep,
articleno = {118},
numpages = {23},
keywords = {Service Quality, Internet of Things, Domestic Gas Pipeline, Decision Tree}
}

