@inproceedings{10.1145/3773274.3774272,
author = {Ben Ali, Ahmed and Labit, Yann and Nougnanke, Benoit and Baffier, Jean-Fran{\c c}ois},
title = {Protocol-to-Model Translation Framework: Enabling Mathematically Tractable TCP Models for Autonomic Controller Design},
year = {2026},
isbn = {9798400722851},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3773274.3774272},
doi = {10.1145/3773274.3774272},
abstract = {Multi-tenant datacenter environments require autonomic network management systems that can adapt to heterogeneous TCP variants without manual intervention to maintain performance guarantees and SLA compliance. However, existing TCP modeling approaches cannot translate protocol specifications into control-theoretic models while preserving both the behavioral fidelity and mathematical tractability required for designing such self-managing systems. Previous work has failed to address the trade-off between modeling accuracy and mathematical properties essential for advanced controller synthesis, with classical models lacking accuracy for modern TCP variants and recent approaches sacrificing the tractability needed for real-time autonomic systems. This work introduces a protocol-derived framework that extends the Hollot-Misra approach with time-varying parameters extracted directly from RFC specifications, enabling mathematically tractable models that capture modern TCP behavior for autonomic controller design. We developed a systematic methodology encompassing protocol-derived parameter extraction from RFC 6582, mathematical property preservation ensuring controllability and observability, and comprehensive dual-scale validation through both detailed 6-flow mechanistic analysis and large-scale 200-flow statistical evaluation across realistic datacenter scenarios. This framework establishes the methodological foundation for bridging protocol engineering and control theory, enabling the development of sophisticated autonomic AQM controllers that can automatically adapt to diverse TCP variants while maintaining the mathematical guarantees essential for resilient datacenter network infrastructure.},
booktitle = {Proceedings of the 18th IEEE/ACM International Conference on Utility and Cloud Computing},
articleno = {17},
numpages = {10},
keywords = {TCP Modeling, Active Queue Management, Autonomic Systems, Datacenter Networks, Control Theory, Multi-Tenant Applications, Protocol Analysis},
location = {
},
series = {UCC '25}
}

@inproceedings{10.1145/3680529.3688965,
author = {Ramos, Mark and Wu, Ziyang},
title = {Event Modeling},
year = {2024},
isbn = {9798400711329},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3680529.3688965},
doi = {10.1145/3680529.3688965},
abstract = {Event Modeling consists of two works: #dump and AI Fossil.#dump is a live simulated online and VR environment. Ramos and Wu tagged AI generated 3D models with matching keywords from the book Keywords for Today: A 21st Century Vocabulary (2018). Once these keywords are found in new tweets, in real time, #dump will dump the relevant 3D models into the virtual landscape of a salt mine. Hinting at activities of extraction and expansion, the 3D models will continue to 'landfill' the landscape, a metaphor of how digital technology will colonise every facet of our lives.Among the content pushed by his own social media algorithms, artist Ziyang Wu selected news and social events and fed their titles into the image generating Artificial Intelligence dreamfields3D. For AI Fossil, the AI created 3D models from those texts, as if fossilising the filter-bubble reality Wu lives in. In a post-apocalyptic factory scene, visitors can approach the scattered AI fossils to trigger popup banners of the original sources and event titles. The work reveals how textual stories can be fragmented and re-interpreted into virtual objects of sarcasm, grandiosity, obscenity, and obscurity, as processed and apprehended by AI.Event Modeling pronounces how our reality is being mediated and profoundly changed by digital technologies.},
booktitle = {SIGGRAPH Asia 2024 Art Gallery},
articleno = {6},
numpages = {1},
location = {Tokyo, Japan},
series = {SA Art Gallery '24}
}

@inproceedings{10.1145/3767052.3767068,
author = {Jiang, Haoran},
title = {Machine Learning Models for Predicting Second-hand House Prices: A Comparative Study},
year = {2025},
isbn = {9798400716010},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3767052.3767068},
doi = {10.1145/3767052.3767068},
abstract = {This paper presents a comparative analysis of the application of machine learning models in predicting the prices of second-hand houses. It underscores the importance of the real estate market within the economy and points out the advantages of precise predictions for various stakeholders, including homebuyers, real estate agents, and financial institutions. Traditional methods frequently fail to grasp the intricate interactions that impact house prices, whereas machine learning techniques have garnered attention for their capability to handle such complexities. The study made use of the “Shanghai Second-hand Housing Prices from 2024 Anjuke Website” dataset from Kaggle, which comprises 175,135 records, each having nearly 30 features. After undergoing preprocessing procedures like duplicate removal, feature transformation, outlier removal, missing value imputation, feature encoding, feature engineering, and data standardization, the data was divided into training and testing sets. Four machine learning models were compared: Linear Regression, Ridge Regression, Random Forest, and XGBoost. The findings revealed that Random Forest and XGBoost surpassed the linear models, with Random Forest attaining the lowest Mean Absolute Error (MAE) and the highest R² Score. The study concluded that Random Forest was the most effective model for predicting the prices of second-hand houses in Shanghai. Even though the results were promising, the study acknowledged certain limitations such as the temporal and geographical constraints of the dataset and the reliance on historical data. Future research ought to concentrate on real-time data integration, model updating, incorporating additional data sources, and exploring advanced techniques to improve the performance and interpretability of the model.},
booktitle = {Proceedings of the 2025 International Conference on Big Data, Artificial Intelligence and Digital Economy},
pages = {99–106},
numpages = {8},
keywords = {LightGBM, Linear Regression, Machine learning, Random Forest, Ridge Regression, Second-hand house price prediction, XGBoost},
location = {
},
series = {BDAIE '25}
}

@inproceedings{10.1145/3723178.3723222,
author = {Hridita, Sara and Rahman, Musfiqur and Talha, Md Abu and Riaz, Abdul Al Mahmud and Chowdhury, Safwan Ahmad and Hasan, Khandaker Tabin},
title = {Enhancing Accessibility with Real-Time Conversion of Text-to-Sign Language},
year = {2025},
isbn = {9798400713828},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3723178.3723222},
doi = {10.1145/3723178.3723222},
abstract = {Effective communication with the deaf and hard-of-hearing community remains a significant challenge due to the complexities of translating spoken and written language into sign language. This paper introduces a novel real-time text-to-sign language conversion system utilizing advanced Natural Language Processing (NLP) technologies, including transformers and BertTokenizer. Development details include a WebGL-based user interface facilitating seamless interaction with a 3D humanoid character performing accurate sign language animations. The methodology employs robust tokenization, efficiently mapping text to corresponding sign gestures, enhanced by synonym matching and part-of-speech filtering to accommodate linguistic variations. Evaluation using the MS-ASL and WordNet datasets achieved a translation accuracy of 96.8%. This study advances technological frameworks assisting communication with the deaf community and sets the stage for future enhancements, such as integrating facial expressions and expanding dataset dimensions to cover more linguistic features.},
booktitle = {Proceedings of the 3rd International Conference on Computing Advancements},
pages = {332–337},
numpages = {6},
keywords = {3D Animation for Sign Language, Accessibility Technologies, Human-Computer Interaction (HCI), Natural Language Processing (NLP), Real-Time Communication Systems, Text-to-Sign Language Translation},
location = {
},
series = {ICCA '24}
}

