@article{10.1145/3816094,
author = {Xu, Ziyu and Cai, Zhuodi},
title = {Creativity ≠ Generativity: A Case Study of Attentive Machine Learning in Dance Performance},
year = {2026},
issue_date = {July 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {9},
number = {3},
url = {https://doi.org/10.1145/3816094},
doi = {10.1145/3816094},
abstract = {Dance expresses through translation. It transforms intention, memory, and affect into embodied movement through tacit and relational knowledge. When computational systems enter this space, they introduce new translation layers that render movement legible to machines and mediate how performance is perceived and remembered. This paper presents a case study of human and machine co-performance as an attentive practice of translation through a bespoke movement recognition system embedded within a twenty-minute multimedia dance theater work. Using wearable IMU sensors and a lightweight time series classifier based on MiniRocket (MINImally RandOm Convolutional Kernel Transform), the system translates performers’ movements into real time audiovisual responses with low latency suitable for live performance. The model is performer-trained and non-generative, where mappings are predefined, but their timing remains open, allowing moments of unpredictability to emerge as a generative force within performance. Through practice-based research and reflection on moments that resisted translation, we argue that human-machine systems in the arts should be evaluated not by accuracy alone, but also by how well they preserve agency, care, and artistic intention.},
journal = {Proc. ACM Comput. Graph. Interact. Tech.},
month = jun,
articleno = {33},
numpages = {9}
}

@inbook{10.1145/3821835.3821931,
author = {Liu, Minyao},
title = {A Multimodal Data Fusion-Based Risk Early Warning Management Model for Cultural Tourism},
year = {2026},
isbn = {9798400723315},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3821835.3821931},
abstract = {This paper proposes a multimodal data fusion-based risk early warning management model for cultural tourism. It constructs a cultural tourism risk data system covering four modalities: time-series sensing, video spatiotemporal data, text-based public opinion data, and spatial geographic data. A five-level risk classification standard adapted to industry norms is formulated. The core of the model is an original spatiotemporal alignment-gated cross-modal fusion algorithm (STAG-CMF). This algorithm addresses the problem of spatiotemporal dimension misalignment in multimodal data through a spatiotemporal alignment module, introduces an adaptive gated cross-modal attention mechanism to achieve lossless and efficient fusion of risk features, and combines a contrastive learning branch to alleviate the overfitting problem in small-sample risk scenarios. An interpretable risk tracing output head is designed to support management decisions. Experiments were conducted based on a self-built multimodal dataset from 12 5A-level scenic spots in China from 2022 to 2025. The results show that the model achieves an F1 score of 96.28%, an improvement of 4.15 percentage points compared to the optimal baseline model. The average early warning lead time for high-risk events reaches 18.6 minutes, and the single-frame inference speed is 28.3 ms. This meets the real-time and accurate risk warning needs of cultural tourism scenarios, providing reliable technical support for intelligent risk management in the cultural tourism industry.},
booktitle = {Proceedings of the 2nd International Conference on Smart City and Sustainable Development},
pages = {634–639},
numpages = {6}
}

@inproceedings{10.1145/3690624.3709379,
author = {Lai, Siqi and Xu, Zhao and Zhang, Weijia and Liu, Hao and Xiong, Hui},
title = {LLMLight: Large Language Models as Traffic Signal Control Agents},
year = {2025},
isbn = {9798400712456},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3690624.3709379},
doi = {10.1145/3690624.3709379},
abstract = {Traffic Signal Control (TSC) is a crucial component in urban traffic management, aiming to optimize road network efficiency and reduce congestion. Traditional TSC methods, primarily based on transportation engineering and reinforcement learning (RL), often struggle with generalization abilities across varied traffic scenarios and lack interpretability. This paper presents LLMLight, a novel framework employing Large Language Models (LLMs) as decision-making agents for TSC. Specifically, the framework begins by instructing the LLM with a knowledgeable prompt detailing real-time traffic conditions. Leveraging the advanced generalization capabilities of LLMs, LLMLight engages a reasoning and decision-making process akin to human intuition for effective traffic control. Moreover, we build LightGPT, a specialized backbone LLM tailored for TSC tasks. By learning nuanced traffic patterns and control strategies, LightGPT enhances the LLMLight framework cost-effectively. Extensive experiments conducted on ten real-world and synthetic datasets, along with evaluations by fifteen human experts, demonstrate the exceptional effectiveness, generalization ability, and interpretability of LLMLight with LightGPT, outperforming nine baseline methods and ten advanced LLMs. Our project is available at https://github.com/usail-hkust/LLMTSCS.},
booktitle = {Proceedings of the 31st ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.1},
pages = {2335–2346},
numpages = {12},
keywords = {intelligent transportation, large language model, traffic control agent, traffic signal control},
location = {Toronto ON, Canada},
series = {KDD '25}
}

@inproceedings{10.1145/3626253.3635516,
author = {Chen, Lujie Karen and Thai, Justin},
title = {Assessment-via-Teaching: Exploring an Alternative Assessment Strategy in Undergraduate Introductory Data Science Course},
year = {2024},
isbn = {9798400704246},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3626253.3635516},
doi = {10.1145/3626253.3635516},
abstract = {Learning-by-teaching is an active learning method that has the promise of engaging students and enhancing their learning. These benefits include the improvement of the metacognitive process, increased motivation and self-efficacy, and the opportunity to refine communication skills. These benefits are particularly valuable in data science education. Though not as widely studied, teaching assignments, where students demonstrate competency through teaching others can be used as a formative assessment tool. This paper describes an "alternative midterm" experiment conducted in an undergraduate introductory data science class. In this pilot, students were asked to demonstrate their newly learned data science skills by teaching them to individuals without data science backgrounds. The evidence of learning will be illustrated through an in-depth analysis of the students' teaching products. These products consist of two parts: (1) "Teaching Preparation" materials, such as Python Notebooks containing problems and solutions crafted by the students, and (2) "Teaching Implementation", video recordings of real-time interactions between the students and their "tutees." The paper will also present qualitative feedback from the students, highlighting promising signs of engagement and acceptance. We will conclude by discussing the challenges and opportunities of implementing this assessment strategy on a larger scale.},
booktitle = {Proceedings of the 55th ACM Technical Symposium on Computer Science Education V. 2},
pages = {1598–1599},
numpages = {2},
keywords = {data science education, learning-by-teaching},
location = {Portland, OR, USA},
series = {SIGCSE 2024}
}

@inproceedings{10.1145/3797552.3797625,
author = {Feng, Yanhua},
title = {Research on Intelligent Early Warning Model for Teaching Quality Based on Multi-source Data Fusion and XAI},
year = {2026},
isbn = {9798400720925},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3797552.3797625},
doi = {10.1145/3797552.3797625},
abstract = {In the context of the OBE education model, achieving accurate diagnosis and forward-looking intervention of teaching quality has become a key issue in education reform. This paper uses course Practical Numerical Methods as a practical carrier to construct an intelligent teaching quality warning model based on multi-source data fusion. We establish an evaluation system by collecting behavioral data, interactive data, achievement data, and emotional data. We use XGBoost algorithm to build an early warning model and introduce the SHAP interpretable artificial intelligence framework for attribution analysis. An innovative adaptive learning framework for concept drift has been proposed. This framework integrates real-time drift detection based on ADWIN algorithm, XGBoost incremental learning, and microservice hot updates, effectively solving the problem of model performance degradation in educational dynamic environments. Research shows that the model can achieve a prediction accuracy of 86.4% and an AUC value of 0.923 in the sixth week of the course. This paper not only provides effective warning tools, but also reveals potential patterns in teaching process from a data-driven perspective, providing theoretical and practical support for achieving precision teaching and personalized learning.},
booktitle = {Proceedings of the 2025 4th International Conference on Artificial Intelligence and Education},
pages = {454–459},
numpages = {6},
keywords = {Explainable artificial intelligence, Multi-source data fusion, Teaching quality warning, XGBoost},
location = {
},
series = {ICAIE '25}
}

@inproceedings{10.1145/3801438.3803160,
author = {Zhao, Xiangkai and Feng, Yuyao and Sun, Daijie and Gao, Liangbin and Xu, Tongxin and Lv, Jiaming and Zhou, Guangrong and Xia, Chengliangyi},
title = {A Review of Large Language Models for Cybersecurity Defense: Core Capabilities, Application Practices, and Challenges},
year = {2026},
isbn = {9798400721557},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3801438.3803160},
doi = {10.1145/3801438.3803160},
abstract = {The rapid evolution of cyber threats — characterized by advanced persistent threats (APTs), software supply chain attacks, and AI-driven adversarial payloads — has exposed fundamental limitations in traditional rule-based and signature-based defense mechanisms. Large Language Models (LLMs), with core capabilities spanning natural language understanding, code engineering, logical reasoning, and autonomous decision-making, offer a transformative paradigm for cybersecurity defense. This paper presents a systematic review of LLM applications across the entire cybersecurity defense lifecycle. The review begins with an analysis of the core capabilities and key enabling technologies of LLMs — including prompt engineering, domain fine-tuning, Retrieval-Augmented Generation (RAG), and agent frameworks — that underpin their adaptation to security tasks. Application practices are then examined across four critical stages: pre-attack prevention and secure development (covering vulnerability detection, secure code generation, supply chain security, and malware/phishing detection), during-attack detection and threat awareness (including network intrusion detection, log analysis, and threat intelligence automation), post-attack response and disposition (encompassing digital forensics and automated incident response),. The paper further dissects the security risks inherent to LLMs themselves — such as prompt injection, jailbreaking, data poisoning, and model stealing attacks — along with corresponding defense technologies. Finally, key challenges are identified, including hallucination, real-time performance bottlenecks, domain knowledge scarcity, data silos, interpretability deficits, and compliance risks, with future research directions proposed toward building more robust, trustworthy, and human-centered intelligent defense systems.},
booktitle = {Proceedings of the 3rd International Conference on Machine Intelligence and Digital Applications},
pages = {1999–2009},
numpages = {11},
keywords = {Cybersecurity Defense, Defense Lifecycle, Intrusion Detection, LLM Security, Large Language Models, Threat Intelligence, Vulnerability Detection},
location = {
},
series = {MIDA 2026}
}

@inproceedings{10.1145/3793811.3793817,
author = {Saiedur Rahaman, Mohammad and Morshed, Ahsan and Kwan, Paul},
title = {Leveraging Multimodal Generative AI to Enhance Engagement and Systematic Learning in ICT Education},
year = {2026},
isbn = {9798400723155},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3793811.3793817},
doi = {10.1145/3793811.3793817},
abstract = {Many students in ICT units struggle to progress when working with abstract concepts, programming tasks, or complex software, particularly when they cannot articulate where they are stuck or what support they need. This often leads to frustration, disengagement, and a shift toward trial-and-error rather than systematic problem-solving. While Generative AI tools are increasingly available as learning companions, most depend on well-crafted prompts and cannot "see" what students are doing on their screens, limiting their usefulness during authentic task-based learning. This paper reports on a simulated multimodal Generative AI peer learning system to address this challenge. Through real-time screen-sharing and voice interaction, the AI interprets on-screen content and user actions, identifies points of confusion, and provides step-by-step guidance aligned with structured problem-solving workflows. The approach was trialled across three ICT units. Students reported increased engagement, clearer articulation of learning difficulties, and stronger development of systematic learning practices when working independently, which corresponded with a substantial improvement in unit satisfaction scores. These findings highlight the practical value of multimodal Generative AI tutors for effective on-demand learning support and provide actionable guidance for educators integrating Generative AI meaningfully into ICT education.},
booktitle = {Proceedings of the 2026 Australasian Computer Science Week},
pages = {73–76},
numpages = {4},
keywords = {Generative AI, Systematic Learning, Human-Computer Interaction, ICT Education, Multi-modal AI.},
location = {
},
series = {ACSW '26}
}

@inproceedings{10.1145/3600100.3626341,
author = {Xie, Jiajia and Salley, Christin J and Mohammadi, Neda and Taylor, John E},
title = {Online Confirmation-Augmented Probabilistic Topic Modeling in Cyber-Physical Social Infrastructure Systems},
year = {2023},
isbn = {9798400702303},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3600100.3626341},
doi = {10.1145/3600100.3626341},
abstract = {Online probabilistic topic models serve as essential analytical tools within Cyber-Physical Social Infrastructure Systems (CPSIS), enabling the analysis of real-time data streams. These models empower operators and decision-makers with actionable insights, anomaly detection, predictions, optimized resource allocation, user engagement, and social feedback, all critical for responding to evolving CPSIS conditions. While these models use inferred topic-assignment distributions to create lower-dimensional representations, applying them to online user-generated streams, like social media and community apps, has historically posed challenges due to sparse relevant content, leading to suboptimal performance. Our study proposes a novel and expanded version of topic models that integrates the variational lower bound with a linear reward function, supervised by a label associated with the confidence of relevant content presence. We introduce a learning algorithm designed for these augmented topic models. Our empirical experiments, conducted on real-world datasets, provide compelling evidence that our approach uniquely enhances the potential of any topic model in CPSIS for downstream tasks in information management. These enhancements encompass improved topic interpretability, enhanced data labeling precision, and the refinement of similarity metrics, reinforcing the effectiveness of our online confirmation-augmented probabilistic topic modeling approach in processing and analyzing CPSIS real-time data streams.},
booktitle = {Proceedings of the 10th ACM International Conference on Systems for Energy-Efficient Buildings, Cities, and Transportation},
pages = {390–397},
numpages = {8},
keywords = {information augmentation, online machine learning, topic models, variational bayes},
location = {Istanbul, Turkey},
series = {BuildSys '23}
}

@inproceedings{3721488.3721641,
author = {Abbo, Giulio Antonio and Belpaeme, Tony},
title = {I Was Blind but Now I See: Implementing Vision-Enabled Dialogue in Social Robots},
year = {2025},
publisher = {IEEE Press},
abstract = {In the rapidly evolving landscape of human-robot interaction, the integration of vision capabilities into conversational agents stands as a crucial advancement. This paper presents a ready-to-use implementation of a dialogue manager that leverages the latest progress in Large Language Models (e.g., GPT-4o mini) to enhance the traditional text-based prompts with real-time visual input. LLMs are used to interpret both textual prompts and visual stimuli, creating a more contextually aware conversational agent. The system's prompt engineering, incorporating dialogue with summarisation of the images, ensures a balance between context preservation and computational efficiency. Six interactions with a Furhat robot powered by this system are reported, illustrating and discussing the results obtained. The system can be customised and is available as a stand-alone application, a Furhat robot implementation, and a ROS2 package.},
booktitle = {Proceedings of the 2025 ACM/IEEE International Conference on Human-Robot Interaction},
pages = {1176–1180},
numpages = {5},
keywords = {conversation, dialogue, hri, large language model, prompt engineering, ros, vision language model},
location = {Melbourne, Australia},
series = {HRI '25}
}

@inproceedings{10.1145/3785987.3786101,
author = {Zhu, Shihong and Fang, Qingyun and Zheng, Rongyue and Zhu, David Z.},
title = {Automating Classroom Observation: AI-Enabled Behavior Monitoring for Adaptive Educational Management},
year = {2026},
isbn = {9798400720956},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3785987.3786101},
doi = {10.1145/3785987.3786101},
abstract = {Automated classroom behavior monitoring is pivotal for enhancing pedagogical decision-making and enabling adaptive learning environments. While computer vision techniques offer promising solutions, existing approaches face challenges in recognizing fine-grained behaviors under real-world complexities and translating detections into pedagogically meaningful insights. This study proposes a novel dual-modality framework that synergistically integrates: (1) a Transformer-enhanced YOLO11 detector incorporating lightweight Transformer blocks into the convolutional backbone to model long-range dependencies and contextual cues, significantly improving recognition robustness against occlusion, scale variance, and gesture ambiguity; and (2) the Qwen2.5-VL-7B vision-language model (VLM) that generates natural language summaries, engagement metrics, and instructional recommendations through cross-modal reasoning. Evaluated on the SCB-Dataset, our method achieves state-of-the-art performance with 74.9% recall and 61.9% mAP, while reducing computational cost by 4.5%. Beyond technical superiority, the framework provides educators with actionable insights—including real-time engagement scores and spatial participation patterns—demonstrating significant potential for scalable, evidence-based educational management. This work bridges the gap between low-level behavior perception and high-level pedagogical intelligence, advancing the development of interpretable AI systems for smart classrooms.},
booktitle = {Proceedings of the 2025 2nd International Conference on Artificial Intelligence and Future Education},
pages = {686–693},
numpages = {8},
keywords = {Automated classroom observation, artificial intelligence, YOLO11, Transformer, vision-language model},
location = {
},
series = {AIFE '25}
}

@article{10.1145/3816079,
author = {Wang, Ruipeng and Cheng, Yuxiang and Xing, Zhiyan and Farahi, Behnaz},
title = {Resonance: Meditative Neural Rhythms as Collective Spatial Experience},
year = {2026},
issue_date = {July 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {9},
number = {3},
url = {https://doi.org/10.1145/3816079},
doi = {10.1145/3816079},
abstract = {Resonance is an interactive installation that externalizes meditation as collective spatial experience by translating a meditator’s neural rhythms into water, vibration, and light. Real-time EEG data modulates vibration within a suspended water vessel, generating wave patterns whose refracted caustics are projected across the surrounding architecture. Rather than visualizing cognition as abstract data, the system situates neural activity within physical matter and immersive space, forming an embodied relationship between mind, matter, and architecture.Grounded in theories of extended cognition, Resonance proposes that bio-responsive environments can actively participate in shaping attention and awareness. By shifting neurofeedback from individual interaction to immersive spatial media, this work transforms meditation from a solitary practice into a phenomenon that surrounds and immerses the audience. The project synthesizes meditation traditions, fluid mechanics, and computational design, contributing a spectator-centered model of bio-responsive design where cognition is encountered not as private feedback but as shared experience. Through this synthesis, Resonance expands interactive media toward embodied presence and shared contemplative experience, allowing inner states to be sensed collectively.},
journal = {Proc. ACM Comput. Graph. Interact. Tech.},
month = jun,
articleno = {26},
numpages = {13}
}

@inproceedings{10.1145/3786183.3786196,
author = {Amahan, Pilita A and Pastrana, Nimfa B and Gonzales, Artemio M},
title = {Project GEDI: Promoting Gender Equity and Diversity in Classroom Settings using Artificial Intelligence},
year = {2026},
isbn = {9798400720734},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786183.3786196},
doi = {10.1145/3786183.3786196},
abstract = {This study investigates gender-based disparities in classroom participation, feedback sentiment, and instructional content using ethically collected data from 300 students. Three equity indicators: underrepresentation, stereotyped feedback, and material bias were flagged through a structured, rule-based annotation framework. Analysis revealed that female and nonbinary students consistently experienced reduced engagement, neutral feedback, and exposure to biased materials, while male students received higher participation scores and affirming feedback without content bias. To enhance interpretative depth, findings were further analyzed using Transformer-based sentiment models (BERT and FAIRBert), which were benchmarked against the rule-based guidelines. Composite indices such as the Gender Responsiveness Score underscored persistent structural inequities across identity groups. These diagnostic outcomes directly informed the design and development of Project GEDI, an AI-powered prototype that translates classroom data into real-time bias evaluations and pedagogical recommendations. More than an evaluation tool, GEDI functions as a dynamic equity monitor that supports inclusive teaching practices. This research demonstrates the effectiveness of combining semantic annotation, AI modeling, and human intervention to operationalize inclusive education. Future work may expand GEDI's scope to support longitudinal tracking, subject-specific calibration, and adaptive interventions across diverse learning environments.},
booktitle = {Proceedings of the 2025 8th International Conference on Big Data and Education},
pages = {13–20},
numpages = {8},
keywords = {Bias Detection, Educational AI, Feedback Sentiment Analysis, Gender equity in Education, Inclusive Pedagogy},
location = {
},
series = {ICBDE '25}
}

@inproceedings{10.1145/3581791.3597285,
author = {Liao, Jingyi and Ruttik, Kalle and J{\"a}ntti, Riku and Phan-Huy, Dinh-Thuy},
title = {Demo: UE Assisted Ambient IoT in LTE Downlink, in real-time and open source},
year = {2023},
isbn = {9798400701108},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3581791.3597285},
doi = {10.1145/3581791.3597285},
abstract = {Ambient power enabled Internet of Things a.k.a. Ambient IoT is a novel concept connecting battery-free energy autonomous devices to the Internet. In this paper, we demonstrate the feasibility of using the channel estimator at the user equipment (UE) as a receiver for backscatter signals in LTE downlink. Our real-time demonstrator system consists of signal generator that mimics the operation of a base station (BS), a backscatter device (BD) modulating the incidence signal, and a software defined radio receiver that plays the role of the user equipment. The UE channel estimator and BD demodulation software is implemented with C++ and Python, respectively and made open source. Our results indicate that UE can demodulate the BD signal with bit error less than 10-3 when the downlink signal-to-noise ratio is larger than 10 dB when the pathloss between the BD and UE is less than 13 dB.},
booktitle = {Proceedings of the 21st Annual International Conference on Mobile Systems, Applications and Services},
pages = {588–589},
numpages = {2},
keywords = {LTE, IoT, ambient backscatter communication},
location = {Helsinki, Finland},
series = {MobiSys '23}
}

@inproceedings{10.1145/3806980.3807379,
author = {Yu, Yanjun and Xu, Liurong},
title = {Explainable XGBoost-Driven Personalized Learning System for Psychological Counseling Skills},
year = {2026},
isbn = {9798400722073},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3806980.3807379},
doi = {10.1145/3806980.3807379},
abstract = {Traditional psychological counseling skills learning is constrained by unified instructional approaches, delayed practical feedback, and insufficient alignment between learning resources and individual needs. To address these challenges, this study develops an explainable XGBoost-driven personalized learning system for psychological counseling skills. The system adopts a hierarchical architecture consisting of a data layer, an algorithm layer, and an application layer, and integrates machine learning, deep learning, and natural language processing to support intelligent assessment, adaptive learning path planning, and real-time interactive tutoring. In particular, an XGBoost model is applied to questionnaire data collected from 327 learners to model perceived learning effectiveness and system acceptance, while SHapley Additive exPlanations (SHAP) are employed to interpret the contribution of different AI-enabled system functions (e.g., machine learning–based assessment, NLP-based interaction, and multimodal evaluation) to user-perceived outcomes. An eight-week controlled experiment further demonstrates that the proposed system improves learners’ counseling skill mastery efficiency by over 20% and increases learning resource matching by more than 38% compared with traditional learning methods. These results indicate that combining explainable machine learning with personalized learning system design enhances both learning effectiveness and transparency, providing practical technical support for the intelligent development of psychological counseling skills training.},
booktitle = {Proceedings of the 2026 International Conference on Big Data and Informatization Education},
pages = {1496–1502},
numpages = {7},
keywords = {Intelligent Tutoring, Multimodal Assessment, Personalized Learning System, Psychological Counseling Skills, XGBoost},
location = {
},
series = {ICBDIE '26}
}

@inproceedings{10.1145/3632775.3661974,
author = {Van Puyvelde, Toon and Verwee, Marie-Sophie and Gokhale, Gargya and Zareh, Mehran and Develder, Chris},
title = {HomeLabGym: A real-world testbed for home energy management systems},
year = {2024},
isbn = {9798400704802},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3632775.3661974},
doi = {10.1145/3632775.3661974},
abstract = {Amid growing environmental concerns and resulting energy costs, there is a rising need for efficient Home Energy Management Systems (HEMS). Evaluating such innovative HEMS solutions typically relies on simulations that may not model the full complexity of a real-world scenario. On the other hand, real-world testing, while more accurate, is labor-intensive, particularly when dealing with diverse assets, each using a distinct communication protocol or API. Centralizing and synchronizing the control of such a heterogeneous pool of assets thus poses a significant challenge. In this paper, we introduce HomeLabGym, a real-world testbed to ease such real-world evaluations of HEMS and flexible assets control in general, by adhering to the well-known OpenAI Gym paradigm. HomeLabGym allows researchers to prototype, deploy, and analyze HEMS controllers within the controlled test environment of a real-world house (the IDLab HomeLab), providing access to all its available sensors and smart appliances. The easy-to-use Python interface eliminates concerns about intricate communication protocols associated with sensors and appliances, streamlining the evaluation of various control strategies. We present an overview of HomeLabGym, and demonstrate its usefulness to researchers in a comparison between real-world and simulated environments in controlling a residential battery in response to real-time prices.},
booktitle = {Proceedings of the 15th ACM International Conference on Future and Sustainable Energy Systems},
pages = {478–479},
numpages = {2},
keywords = {Hardware, Home Energy Management, Prototyping, Reinforcement Learning},
location = {Singapore, Singapore},
series = {e-Energy '24}
}

@inproceedings{10.1145/3570236.3570242,
author = {Chen, Min and Ye, Lei and Li, Siming and Yuan, Xiayin and Manta, Otilia and Yue, Xiao-Guang},
title = {Research on Optimization of Customer Satisfaction Evaluation System Based on Data Mining},
year = {2023},
isbn = {9781450396714},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3570236.3570242},
doi = {10.1145/3570236.3570242},
abstract = {With the advent of the era of big data, the competition among enterprises has become more and more intense, and user satisfaction has also become the focus of enterprises. On the basis of previous research, combined with big data mining method, this paper collects the status quo data of enterprise development with the help of python software, and further analyzes customer satisfaction in the form of questionnaire survey. Satisfaction is measured, and finally the corresponding system optimization research is carried out through the IPA cross model. It provides a feasible analysis and optimization strategy for building a product satisfaction evaluation system based on multi-dimensional mining, automatic analysis and real-time tracking of user comment data.},
booktitle = {Proceedings of the 7th International Conference on Intelligent Information Processing},
articleno = {6},
numpages = {11},
keywords = {structural equation, system optimization, Big data, customer satisfaction evaluation, data mining},
location = {Bucharest, Romania},
series = {ICIIP '22}
}

@inproceedings{10.1145/3774904.3792818,
author = {Ni, Ziheng and Liu, Congcong and Shang, Cai and Sun, Yiming and Li, Junjie and Fang, Zhiwei and Chen, Guangpeng and Jian, Li and Zhang, Zehua and Peng, Changping and Lin, Zhangang and Law, Ching and Shao, Jingping},
title = {A Generative Contextual Comprehension Paradigm for Takeout Ranking Model},
year = {2026},
isbn = {9798400723070},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774904.3792818},
doi = {10.1145/3774904.3792818},
abstract = {The ranking stage serves as the central optimization and allocation hub in advertising systems, governing economic value distribution through eCPM and orchestrating the user-centric blending of organic and advertising content. Prevailing ranking models often rely on fragmented modules and hand-crafted features, limiting their ability to interpret complex user intent. This challenge is further amplified in location-based services such as food delivery, where user decisions are shaped by dynamic spatial, temporal, and individual contexts. To address these limitations, we propose a novel generative framework that reframes ranking as a context comprehension task, modeling heterogeneous signals in a unified architecture. Our architecture consists of two core components: the Generative Contextual Encoder (GCE) and the Generative Contextual Fusion (GCF). The GCE comprises three specialized modules: a Personalized Context Enhancer (PCE) for user-specific modeling, a Collective Context Enhancer (CCE) for group-level patterns, and a Dynamic Context Enhancer (DCE) for real-time situational adaptation. The GCF module then seamlessly integrates these contextual representations through low-rank adaptation. Extensive experiments confirm that our method achieves significant gains in critical business metrics, including click-through rate and platform revenue. We have successfully deployed our method on a large-scale food delivery advertising platform, demonstrating its substantial practical impact. This work pioneers a new perspective on generative recommendation and highlights its practical potential in industrial advertising systems.},
booktitle = {Proceedings of the ACM Web Conference 2026},
pages = {7712–7723},
numpages = {12},
keywords = {contextual modeling, generative ranking, advertising systems},
location = {United Arab Emirates},
series = {WWW '26}
}

@inproceedings{10.1145/3774904.3792232,
author = {Qiu, Mingjie and Tan, Zhiyi and Bao, Bing-Kun},
title = {Social Event Prediction via Fourier Graph Learning},
year = {2026},
isbn = {9798400723070},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774904.3792232},
doi = {10.1145/3774904.3792232},
abstract = {Social event prediction has garnered increasing attention in web-centered society. Most existing studies represent web-based event stream as chronological graph sequences, then leverage RNNs and GNNs to model temporal and relational patterns. However, this paradigm is inherently flawed: (1) RNNs struggle to capture long-term temporal dependencies, ignoring those temporally distant but influential events. (2) Spatio-temporal GNNs exhibit high computational complexity on large-scale real-time event streams, which hinders their web applications. To this end, we explore a novel paradigm called Fourier Graph Learning from the perspective of frequency domain. Specifically, we first define a novel data structure called Fourier Graph (FG). In FG, both nodes and edges are complex vectors, with real part encoding semantics and imaginary part representing semantic-specific temporal patterns. These temporal patterns are obtained by semantic-aware frequency filter, which utilizes semantics as guidance to adaptively incorporates both long-term dependency and short-term dynamic. Based on FG, we further propose Fourier Graph Neural Network (FGNN). It replaces time-domain convolution with frequency-domain multiplication for efficient aggregation. FGNN also includes a complex-valued event decoder, which fully leverages semantics and temporal patterns from complex space to predict future event probabilities. Extensive experiments show our superior performance with higher accuracy, less complexity and better interpretability compared with baselines.},
booktitle = {Proceedings of the ACM Web Conference 2026},
pages = {4587–4598},
numpages = {12},
keywords = {social event prediction, fourier analysis, graph neural network},
location = {United Arab Emirates},
series = {WWW '26}
}

@inproceedings{10.1145/3678698.3687195,
author = {Jiang, Yuyang and Huang, Zhuoxin and Yu, Luwen and Hui, Pan and Li, Hao},
title = {See My Sea - Emotion Translation and Visualization},
year = {2024},
isbn = {9798400709678},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3678698.3687195},
doi = {10.1145/3678698.3687195},
abstract = {"See My Sea" is an innovative project that integrates art and emotion to explore human emotions through facial expressions. Utilizing advanced facial recognition and real-time data processing, the project captures subtle emotional cues and translates them into dynamic visualizations of ocean particles. This artistic endeavor transforms transient facial movements into fluid, evolving visual patterns, mirroring the vast and ever-changing nature of the sea. Viewers engage interactively with their emotional states, influencing the visual output and fostering a deeper understanding of their inner selves.},
booktitle = {Proceedings of the 17th International Symposium on Visual Information Communication and Interaction},
articleno = {40},
numpages = {3},
keywords = {Somatosensory Interaction, Facial Emotion, Emotion Design, Mental Health},
location = {
},
series = {VINCI '24}
}

@inproceedings{1322109.2927677,
author = {Lokuciejewski, P. and Falk, H. and Theiling, H.},
title = {Design of a WCET-Aware C Compiler},
year = {2006},
isbn = {0780397835},
publisher = {IEEE Computer Society},
address = {USA},
abstract = {This paper presents techniques to integrate worst-case execution time (WCET) data into a compiler. Currently, a tight integration of WCET into compilers is strongly desired, but only some ad-hoc approaches were reported currently. Previous work mainly used self-written WCET estimators with limited functionality and preciseness during compilation. A very tight integration of a high quality WCET analyzer into a compiler was not yet achieved. This work is the first to present such a tight coupling between a compiler and the WCET analyzer aiT. This is done by automatically translating the assembly-like contents of the compiler's low-level format (LLIR) to aiT's exchange format CRL2. Additionally, the results produced by aiT are automatically collected and re-imported into the compiler infrastructure. The work described in this paper is smoothly integrated into a C compiler for the Infineon TriCore processor. It opens up new possibilities for the design of WCET-aware optimizations in the future. The concepts for extending the compiler structure are kept very general so that they are not limited to WCET information. Rather, it is possible to use our concepts also for multi-objective optimization of e. g. best-case execution time (BCET) or energy dissipation},
booktitle = {Proceedings of the 2006 IEEE/ACM/IFIP Workshop on Embedded Systems for Real Time Multimedia},
series = {ESTMED '06}
}

