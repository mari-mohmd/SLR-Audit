doi = {10.1145/3715669.3727350},
abstract = {CUPIDO (Circuit for Unobtrusive Palpebral Interpretation and Detection Optimization) is an ultra-low-power electrostatic sensor able to convert eye blinks into digital events with a detection sensitivity up to ( 90.5 ,% ). It can be easily integrated into the rims of smart glasses allowing for contactless interaction without compromising comfort and privacy (since no camera is used). Thanks to its extremely low power consumption (( 385.1 ,mu mathrm{W} ) at peak during the blink), CUPIDO can extend battery life in smart glasses, allowing for continuous and real-time (detection latency of approximately 1 ms) monitoring applications like hands-free glasses control, assistive technologies, augmented reality, and drowsiness monitoring while driving.},
