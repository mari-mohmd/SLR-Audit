}

@inproceedings{10.1145/3691620.3694995,
author = {Eder, Florian and Winter, Stefan},
title = {Efficient Detection of Test Interference in C Projects},
year = {2024},
isbn = {9798400712487},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3691620.3694995},
doi = {10.1145/3691620.3694995},
abstract = {During test execution, automated software tests can interfere, i.e., their results can deviate depending on their (possibly interleaved) execution order. Such interference imposes severe restrictions on regression testing, when execution order is not or cannot be controlled for, as they can lead to non-deterministic deviations of test results giving false indication of regressions in the code base. While the phenomenon has been extensively studied for Java and Python projects, it remains unclear if or how the obtained results apply for other languages with different testing practices. Our study contributes to filling that gap by reporting results from a large-scale study on test interference in 134 C projects.To cope with the combinatorial explosion of test execution counts when testing with all possible test orders, we propose and evaluate four novel dynamic reduction strategies for test permutations, which yield massive reductions in the number of test sequences to execute. As these strategies are specific to the resources that tests interfere on, rather than the language in which the code is written, we expect them to be useful for the study of test interference in other languages beyond C.Based on the results obtained with these reductions, our results indicate that test order dependencies are far less common in C projects, compared to Java or Python, and that other aspects (concurrency, CPU time) more frequently threaten test result stability.},
booktitle = {Proceedings of the 39th IEEE/ACM International Conference on Automated Software Engineering},
pages = {166–178},
numpages = {13},
keywords = {test interference, flaky tests, C},
location = {Sacramento, CA, USA},
series = {ASE '24}
}

@inproceedings{10.1145/3797161.3797165,
author = {Lai, Mingzhan and Liu, Li and Zhou, Baojun},
title = {Cost aware lightweight network with two-stage attention enhancement for predictive spectrum access},
year = {2026},
isbn = {9798400719349},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3797161.3797165},
doi = {10.1145/3797161.3797165},
abstract = {Dynamic Spectrum Access (DSA) enables secondary users to dynamically occupy spectrum resources during idle time slots of primary users, thereby improving overall spectrum utilization. However, in practical systems, accurately predicting which subbands will be idle in the next time slot within extremely short durations remains a critical challenge. To address this, this paper proposes a lightweight predictive spectrum access model, NPSA-Lite, which is a compact prediction model based on a cost-aware convolutional neural network (CNN). The model takes the time-frequency energy spectrogram of the past T frames as input and outputs the idle probability of each subband in the next frame, then allocates spectrum resources through a greedy Top-K scheduling strategy. To mitigate collision risks, this study designs a cost-weighted binary cross-entropy loss function, assigning higher penalties to the error of “mistakenly occupying an idle subband,” thereby suppressing collisions from the training phase onward. NPSA-Lite employs a three-layer 2D convolutional structure with adaptive pooling, resulting in minimal computational requirements and suitability for real-time deployment on CPU environments. Experiments conducted on synthetic Markov spectrum sequences, TorchSig-generated signals, and publicly available DeepSig RADIOML 2018.01A datasets demonstrate that this method significantly enhances spectrum efficiency and effectively reduces collision rates while maintaining extremely low computational overhead, outperforming baseline approaches such as energy detection and random selection. The findings indicate that combining cost-aware learning with small model design is a crucial direction for achieving interpretable and deployable predictive spectrum access.},
booktitle = {Proceedings of the 2025 3rd International Conference on Artificial Intelligence, Systems and Network Security},
pages = {20–25},
numpages = {6},
keywords = {Convolutional neural network, Cost aware learning, Dynamic spectrum access, Predictive spectrum access, Spectrum efficiency, lightweight model},
location = {
},
series = {AISNS '25}
}

@inproceedings{10.1145/1529282.1529733,
author = {Lombardi, Flavio and Di Pietro, Roberto},
title = {KvmSec: a security extension for Linux kernel virtual machines},
year = {2009},
isbn = {9781605581668},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/1529282.1529733},
doi = {10.1145/1529282.1529733},
abstract = {Virtualization is increasingly being used in regular desktop PCs, data centers and server farms. One of the advantages of introducing this additional architectural layer is to increase overall system security.In this paper we propose an architecture (KvmSec) that is an extension to the Linux Kernel Virtual Machine aimed at increasing the security of guest virtual machines. KvmSec can protect guest virtual machines against attacks such as viruses and kernel rootkits. KvmSec enjoys the following features: it is transparent to guest machines; it is hard to access even from a compromised virtual machine; it can collect data, analyze them, and act consequently on guest machines; it can provide secure communication between each of the guests and the host; and, it can be deployed on Linux hosts and at present supports Linux guest machines. These features are leveraged to implement a real-time monitoring and security management system. Further, differences and advantages over previous solutions are highlighted, as well as a concrete roadmap for further development.},
booktitle = {Proceedings of the 2009 ACM Symposium on Applied Computing},
pages = {2029–2034},
numpages = {6},
keywords = {virtual machine, real-time monitoring, kernel virtual machine, integrity, hypervisor},
location = {Honolulu, Hawaii},
series = {SAC '09}
}

@inproceedings{10.1145/3447527.3474848,
author = {Tan, Nicole and Sreedhar, Rachana and Vazquez, Christian and Stigile, Jessica and Gomez, Maria and Subramani, Ashwin and Sadalgi, Shrenik},
title = {An Augmented Reality Guided Capture Platform for Structured and Consistent Product Reference Imagery},
year = {2021},
isbn = {9781450383295},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3447527.3474848},
doi = {10.1145/3447527.3474848},
abstract = {Within e-commerce, vendors require high quality, consistent reference imagery to showcase products. Capturing correct images is difficult when photographic intent has to be conveyed through written instructions, as lack of real-time guidance leads to subjectivity in the interpretation of directions. Hiring professional photographers to conform to specific aesthetics can be expensive. The ubiquity of mobile devices and rapid improvements in augmented reality have facilitated the creation of experiences with in-situ guidance. We present Guided Capture, a mobile application utilizing augmented reality to enable structured capture of consistent user-generated content for reference imagery with real-time feedback. Results from user studies have shown that our system creates a streamlined feedback loop to reduce possible user error, scalable across large groups of people.},
booktitle = {Adjunct Publication of the 23rd International Conference on Mobile Human-Computer Interaction},
articleno = {2},
numpages = {6},
keywords = {Online Retail, Collaborative Photography, Augmented Reality},
location = {Toulouse &amp; Virtual, France},
series = {MobileHCI '21}
}

@inproceedings{10.1145/3746252.3761269,
author = {Pham, Thinh and Diep, Nghiem and Liao, Lizi and Nguyen, Binh T.},
title = {DistillCaps: Enhancing Audio-Language Alignment in Captioning via Retrieval-Augmented Knowledge Distillation},
year = {2025},
isbn = {9798400720406},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746252.3761269},
doi = {10.1145/3746252.3761269},
abstract = {Automated audio captioning (AAC) benefits from incorporating external context to interpret complex sounds, but doing so with retrieval-augmented generation (RAG) at inference is sometimes infeasible due to data availability or incurs significant latency and complexity. We propose DistillCaps, a novel training-time framework that leverages RAG to guide knowledge distillation for improved audio-language alignment, while lessening the reliance on retrieval during inference. In our framework, a RAG-equipped teacher model retrieves relevant textual information (e.g., similar captions) for each audio clip and uses it for training to generate context-enriched captions. Simultaneously, a student model is trained to imitate this teacher, learning to produce high-quality captions from audio alone. We further introduce a Fast Fourier Transform (FFT) adapter in the audio encoder to inject frequency-domain features, enhancing the quality of audio representations before feeding them into the language model. The result is an efficient captioning model that retains RAG's contextual benefits without its deployment overhead. On standard AAC benchmarks (AudioCaps and Clotho), DistillCaps achieves performance competitive with or exceeding prior RAG-based systems despite using no retrieval at test time. Notably, our distilled model matches state-of-the-art captioning results under real-time settings, and when optionally allowing retrieval, it even outperforms previous models by up to 4% on the Clotho benchmark on the in-distribution setting, demonstrating the effectiveness of RAG-guided distillation for audio-language alignment. Code and dataset are available here. https://github.com/pgthinh/DistillCaps.},
booktitle = {Proceedings of the 34th ACM International Conference on Information and Knowledge Management},
pages = {2346–2356},
numpages = {11},
keywords = {audio captioning, knowledge distillation, rag},
location = {Seoul, Republic of Korea},
series = {CIKM '25}
}

@inproceedings{10.1145/3747912.3747951,
author = {Zhang, Jin},
title = {Deep Learning-Based Attribution Framework for Real-Time Budget Optimization in Cross-Channel Pharmaceutical Advertising: A Comparative Study of Traditional and Digital Channels},
year = {2025},
isbn = {9798400715136},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3747912.3747951},
doi = {10.1145/3747912.3747951},
abstract = {This article makes a case for real-time budget adjustments, which should be based on your ad's performance. Regarding customer journeys and their relation with different channels, regular marketing attribution models do not stand a chance, not in a strict regulatory context. In agreement with the current state of the art: explainable machine learning and multilingual sentiment analysis, the solution addresses the incoherent data (many such actions happen infrequently), the delayed conversions, and the global market diversity. In this post, we use multi-head attention bidirectional LSTM networks to quantify the credit that each marketing touchpoint receives, but also across digital and to the online touchpoints within traditional channels. By combining Federated Learning and SHAP interpretability, the framework provides compliance with privacy and transparency in model decision-making. Experiments demonstrate that the proposed framework achieves significant gains in attribution accuracy and resource allocation efficiency over baseline models. Furthermore, multilingual lessons in sentiment signals, coupled with conversion histories of users, provide insight into both when and to what extent one should be adaptively managing budget in response to market variation. In this post, we present a scalable, open, and transparent solution for pharmaceutical advertising COE managers to maximize the ROI of their promotions across this incredibly diverse group of markets.},
booktitle = {Proceedings of the 2025 International Conference on Software Engineering and Computer Applications},
pages = {248–254},
numpages = {7},
keywords = {Cross-Channel Attribution, Deep Learning, Explainable AI, Pharmaceutical Advertising},
location = {
},
series = {SECA '25}
}

@inproceedings{3721488.3721670,
author = {Gonzalez-Sanchez, Javier and Guerra-Silva, Rafael},
title = {Exploring Extended Reality to Optimize Human-Cobot Interaction},
year = {2025},
publisher = {IEEE Press},
abstract = {We explore the integration of extended reality technologies for advancing human-robot collaboration in manufacturing environments. Utilizing a commercial XR headset, the Meta Quest 3, we capture real-time hand and virtual object movements to intuitively control a Universal Robotics e-Series cobot. Our primary objective is to assess whether this interaction paradigm is intuitive for operators while effectively leveraging the cobot's capabilities. Data is streamed from the headset to a broker using MQTT. A local computing module subscribes to the data, translates coordinates into the robot's workspace, and generates control instructions for the cobot. Preliminary findings suggest that XR-based interaction can provide an immersive and efficient framework for human-robot collaboration. These results set the stage for further exploration of multi-user and multi-robot scenarios.},
booktitle = {Proceedings of the 2025 ACM/IEEE International Conference on Human-Robot Interaction},
pages = {1314–1318},
numpages = {5},
keywords = {cobot, collaborative robots, extended reality, hand tracking, meta xr, motion capture, mqtt protocol},
location = {Melbourne, Australia},
series = {HRI '25}
}

@inproceedings{10.1145/3799820.3812480,
author = {Corigliano, Davide and Benchekroun, Otman and Barbi{\v c}, Jernej},
title = {Physics Is Easier Than You Think: From Classical to Neural Elastic Simulation},
year = {2026},
isbn = {9798400725432},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799820.3812480},
doi = {10.1145/3799820.3812480},
abstract = {The demand for high-fidelity, physically-based animation has traditionally been met by sophisticated solvers rooted in elastodynamics and finite element analysis (FEM). Recently, the emergence of neural physics has led to a paradigm shift, transforming neural networks into solvers with memory that dramatically increase the scale and speed of digital environments. Despite its reputation, physics-based simulation does not have to be intimidating. This course aims to demystify the field, proving that these complex systems are accessible and intuitive when approached correctly. We provide a unified journey from classical formulations to modern neural techniques, grounding the audience in the fundamentals of elastostatics and dynamics. We demonstrate how physical problems are discretized via linear finite elements and solved through the elegant lens of optimization. Transitioning into neural physics, we showcase how traditional simulation knowledge translates directly into machine learning loss functions and neural architectures. We analyze strategies for modeling latent spaces for a system’s equilibrium states and to create truly controllable, real-time frameworks. Designed for a broad audience—including students, engineers, researchers, and artists—this course balances theory with practice. To ensure these concepts are immediately actionable, we provide comprehensive reference code for all discussed methods. By the end of the session, attendees will possess the tools to quickly and easily implement their own physics solvers, empowering them to build the next generation of physics-enhanced frameworks and interactive worlds.},
booktitle = {Proceedings of the Special Interest Group on Computer Graphics and Interactive Techniques Conference Courses},
articleno = {32},
numpages = {3},
keywords = {Physically-Based Simulation, Neural Physics, Mesh Representation, Machine Learning},
location = {
},
series = {SIGGRAPH Courses '26}
}

@article{10.1145/3372133,
author = {Lang, Clemens and Stilkerich, Isabella},
title = {Design and Implementation of an Escape Analysis in the Context of Safety-Critical Embedded Systems},
year = {2020},
issue_date = {January 2020},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {19},
number = {1},
issn = {1539-9087},
url = {https://doi.org/10.1145/3372133},
doi = {10.1145/3372133},
abstract = {The use of a managed, type-safe language such as Standard ML, Ada Ravenscar, or Java in hard real-time and embedded systems offers productivity, safety, and dependability benefits at a reasonable cost. Static software systems, that is systems in which all relevant resource entities such as threads and their priorities, for instance, and the entire source code are known ahead of time, are particularly interesting for the deployment in safety-critical embedded systems: Code verification is rather maintainable in contrast to dynamic systems. Additionally, static analyses can incorporate information from all software and system layers to assist compilers in emitting code that is well suited to an application on a particular hardware device. It was shown in the past that a program composed in type-safe Java in combination with a static system setup can be as efficient as one that is written in C [30], which is still the most widely used language in the embedded domain. Escape analysis (EA) is one of several static-analysis techniques. It supports, for instance, runtime efficiency by enabling automated stack allocation of objects. In addition, Stilkerich et al. [27, 28] have argued that EA enables further applications in safety-critical embedded systems such as the computation of memory classes stated in the Real-Time Specification for Java (RTSJ) [6]. EA can be applied to any programming language but the quality of its results greatly benefits from the properties of a type-safe language. Notably, embedded multicore devices can positively be affected by the use of EA. Thus, we explore an ahead-of-time (AOT) escape analysis in the context of the KESO JVM featuring a Java AOT compiler targeting (deeply) embedded (hard) real-time systems.},
journal = {ACM Trans. Embed. Comput. Syst.},
month = feb,
articleno = {6},
numpages = {20},
keywords = {regional memory, memory management, KESO, JVM, Escape analysis}
}

@inproceedings{10.1145/3766671.3766844,
author = {Liu, Zhenyu and Wei, Gaoxia},
title = {Application and influence of digital exercise medicine in depression treatment},
year = {2025},
isbn = {9798400714047},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3766671.3766844},
doi = {10.1145/3766671.3766844},
abstract = {Traditional methods of treating depression are limited by geographical constraints, uneven resource distribution, and low patient compliance. Digital exercise medicine offers innovative solutions for depression treatment by integrating technologies such as video conferencing, mobile apps, wearable devices, and Internet-based cognitive behavioral therapy (iCBT). Aerobic exercises like running and cycling, along with strength training and other diverse activities, combined with personalized exercise plans, can significantly improve depressive symptoms. Digital tools, through real-time data monitoring and feedback, enhance treatment adherence and overcome time and space limitations, benefiting adolescents, the elderly, and patients with specific conditions. However, challenges include technical adaptability, data privacy risks, insufficient evidence of long-term efficacy, and a lack of personalized plans. Future efforts should focus on enhancing technology friendliness, strengthening long-term follow-up studies, exploring multi-modal data-driven precision interventions, and promoting the clinical translation and widespread application of digital exercise medicine through interdisciplinary collaboration.},
booktitle = {Proceedings of the 9th International Conference on Electronic Information Technology and Computer Engineering},
pages = {1003–1007},
numpages = {5},
keywords = {depression, digital exercise medicine, exercise intervention},
location = {
},
series = {EITCE '25}
}

@proceedings{10.1145/1296907,
title = {ISMM '07: Proceedings of the 6th international symposium on Memory management},
year = {2007},
isbn = {9781595938930},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {The International Symposium on Memory Management (ISMM) is a forum for research in management of dynamically allocated memory. Areas of interest include but are not limited to: explicit storage allocation and deallocation; garbage collection algorithms and implementations; compiler analyses to aid memory management; interactions with languages, operating systems, and hardware, especially the memory system; and empirical studies of allocation and referencing behavior in programs that make significant use of dynamic memory.ISMM 2007 continues the tradition of the successful conference series established with the International Workshops on Memory Management held in 1992 and 1995. Since 1998 ISMM has been held biennially, co-located with either OOPSLA or PLDI, and as of this year, has switched to an annual conference.The fourteen papers selected for publication in this volume cover a remarkably broad range of memory management topics from explicit memory management to automatic memory management, optimizing memory locality, and utilizing object lifetimes, support for real time, space compression techniques, specializing garbage collectors, dynamic and static analysis to improve memory management and correctness of memory systems. It also includes two invited keynote talks: by Peter O'Hearn on Separation Logic and Concurrent Resource Management and by David Kirk on NVIDIA CUDA Software and GPU Parallel Computing Architecture.},
location = {Montreal, Quebec, Canada}
}

@inproceedings{10.1145/3456172.3456197,
author = {Andalibi, Farhad and Garcia, Paulo},
title = {Near-Native Interrupt Latency in Real-Time Guests: Handler Emulation Through Memory Map Morphing},
year = {2021},
isbn = {9781450388450},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3456172.3456197},
doi = {10.1145/3456172.3456197},
abstract = {Interrupt latency, critical in real-time applications, is increased in virtualized systems; interrupts intended for a non-running partition can be delayed up to the length of the scheduling period. State-of-the art techniques for decreasing latency in real-time guests relax temporal isolation requirements, allowing guests’ interrupt handlers to be executed within another partition’s time slot. However, this approach does not yet achieve native latencies, due to the need to switch guests’ contexts, inducing overhead for Hypervisor execution. This paper presents an approach for reducing interrupt latencies: by taking advantage of virtualization support hardware in modern microprocessors, we show that real-time guests’ interrupt handlers can be executed within Hypervisor hardware context, i.e., by Hypervisor-dedicated processor hardware, eliminating the need for switching guests’ context and approaching native latencies. This is achieved by morphing the Hypervisor’s memory map translation mechanisms, so software is executed within the real-time guest’s memory context, allowing near-native interrupt latency. We evaluate our implementation, consisting of virtualization hardware and software, on a softcore ARM processor prototyped on a Xilinx Virtex 5 FPGA, running Linux and FreeRTOS. Results show memory map morphing is capable of achieving near-native interrupt latency for a real-time guest, outperforming the state of the art.},
booktitle = {Proceedings of the 2021 7th International Conference on Computing and Data Engineering},
pages = {94–98},
numpages = {5},
keywords = {Virtualization, Runtime environment, Interrupts, Hypervisor, Embedded Systems},
location = {Phuket, Thailand},
series = {ICCDE '21}
}

@inproceedings{10.1145/3728725.3728795,
author = {Zhou, Chenglin and Huang, Cheng and Luo, Xiangyu},
title = {Synthesis of Real-time Linear Dynamic Logic over Finite Traces},
year = {2025},
isbn = {9798400713453},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3728725.3728795},
doi = {10.1145/3728725.3728795},
abstract = {Reactive synthesis, or simply synthesis, is primarily used to automatically generate control-intensive programs. Applications of reactive synthesis span various domains, including robot motion planning, autonomous system control, and communication protocol development. This paper investigates the reactive synthesis for formulas expressed in Real-Time Linear Dynamic Logic over finite traces (RTLDLf). RTLDLf is more expressive than Linear Temporal Logic over finite traces (LTLf). While RTLDLf and Linear Dynamic Logic over finite traces (LDLf) share equivalent expressive power, RTLDLf offers greater simplicity in its logical constructs compared to LDLf. Existing synthesis methods for LDLf predominantly rely on automata-based approaches. In this paper, we propose an RTLDLf synthesis method based on temporal testers. We first translate an RTLDLf specification into a temporal tester, a non-deterministic transducer. The tester is then transformed into a graph game between the system and the environment. We finally propose a symbolic algorithm to solve the game to derive a winning strategy for the system player. The proposed method has two advantages: (1) high composability, enabling convenient and efficient synthesis of complex RTLDLf formulas, and (2) symbolic representation of the tester's transition relations and state space, which facilitates the use of efficient symbolic algorithms based on Ordered Binary Decision Diagrams.},
booktitle = {Proceedings of the 2025 2nd International Conference on Generative Artificial Intelligence and Information Security},
pages = {447–452},
numpages = {6},
keywords = {graph game, linear dynamic logic over finite traces, reactive synthesis, temporal tester},
location = {
},
series = {GAIIS '25}
}

@inproceedings{10.1145/3809986.3810065,
author = {Zhou, Ting and Chen, Qiang and Luo, Haiyang and Cui, Zitao},
title = {YOLOv9-Based Anomaly Detection for Student Health-Related Behaviors Using Heterogeneous Campus Data},
year = {2026},
isbn = {9798400721946},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3809986.3810065},
doi = {10.1145/3809986.3810065},
abstract = {University students face mounting mental health challenges, with traditional reactive monitoring methods suffering from late detection and poor scalability. This paper proposes a novel YOLOv9-based framework (YOLOv9-CA) for proactive detection of health-related behavioral anomalies by fusing heterogeneous campus data. We first conduct modal alignment, feature normalization and time order preservation for multi-source behavioral sequences (campus card, WiFi, LMS, library data), then encode the preprocessed sequential data into pseudo-images—this design adapts the YOLOv9 architecture (originally for spatial feature extraction) to temporal behavior analysis, and YOLOv9 outperforms mainstream temporal models (Transformer/CNN-based sequence models) due to its Programmable Gradient Information (PGI) for gradient retention and Generalized Efficient Layer Aggregation Network (GELAN) for efficient multi-scale temporal feature aggregation. A coordinate attention mechanism is integrated into the YOLOv9 neck to enhance focus on salient time steps and behavioral features, improving detection accuracy and interpretability. The model is trained as a self-supervised reconstruction task, with anomaly scores derived from reconstruction error to identify deviant behavioral patterns. Extensive experiments are conducted on a real-world dataset of 5,728 students (over 30 million records), where anomaly labels are defined as ground truth by cross-referencing university formal psychological counseling and health service records (2.3% anomaly ratio). Results show YOLOv9-CA outperforms traditional machine learning (Isolation Forest, One-Class SVM) and deep learning baselines (LSTM-AE, Transformer-AE) with an F1-score of 0.92, AUPRC of 0.93, and real-time inference speed (5.2 ms per sequence). We also establish a comprehensive ethical deployment framework to address privacy and fairness concerns in student data analysis. This work demonstrates the versatility of YOLOv9 for non-visual temporal anomaly detection and provides a scalable, interpretable solution for university student mental health monitoring.},
booktitle = {Proceedings of the 2026 6th International Conference on Bioinformatics and Intelligent Computing},
pages = {512–518},
numpages = {7},
keywords = {Anomaly detection, Coordinate attention, Heterogeneous data fusion, Student mental health, YOLOv9},
location = {
},
series = {BIC '26}
}

@inproceedings{10.1145/3419249.3420179,
author = {Wallbaum, Torben and Ananthanarayan, Swamy and Matviienko, Andrii and Boll, Susanne},
title = {A Real-time Distributed Toolkit to Ease Children’s Exploration of IoT},
year = {2020},
isbn = {9781450375795},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3419249.3420179},
doi = {10.1145/3419249.3420179},
abstract = {Children are increasingly exposed to everyday objects with embedded computing and wireless capabilities. However, understanding how these devices collect data, communicate information to other devices, and interpret program instructions is not typically taught to children. Moreover, programming these devices still requires considerable knowledge particularly for primary school children. In this paper, we showcase a distributed toolkit of various sensors and output modules, each with wireless capability, that can independently or in concert work together. This is enabled by a programming environment with a real-time interpreter that can connect and update the state of the modules on-the-fly. We tested the system with 32 primary school children in an after-school study and found that the majority of children knew how to couple sensors to different output modalities to solve various devised scenarios. For some children, the toolkit was also used to build IoT games or fulfill personal tasks.},
booktitle = {Proceedings of the 11th Nordic Conference on Human-Computer Interaction: Shaping Experiences, Shaping Society},
articleno = {9},
numpages = {9},
keywords = {education., computational toolkit, children, Internet of things},
location = {Tallinn, Estonia},
series = {NordiCHI '20}
}

@inproceedings{10.1145/3641555.3705191,
author = {Williams, Eldon and Xing, Guangming},
title = {GRADE: Grading and Assessment of Database ER Diagrams},
year = {2025},
isbn = {9798400705328},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3641555.3705191},
doi = {10.1145/3641555.3705191},
abstract = {Entity-relationship (ER) modeling is a crucial component of database education, allowing students to conceptualize real-world problems and translate them into database schemas. Existing tools, such as AutoER, provide automated grading for UML-style diagrams but often lack flexibility in representing more complex relationships. In this poster, we introduce GRADE (&lt;u&gt;Gr&lt;/u&gt; ading and &lt;u&gt;A&lt;/u&gt;ssessment of &lt;u&gt;D&lt;/u&gt;atabase &lt;u&gt;E&lt;/u&gt;R Diagrams), a tool designed to support the creation and automatic grading of ER diagrams. Unlike UML-based alternatives, GRADE focuses on providing a flexible environment for students to construct ER diagrams, improving their understanding of core database concepts. GRADE also offers real-time feedback and scalability in assessments. This poster outlines the features of GRADE and discusses its potential impact on database education.},
booktitle = {Proceedings of the 56th ACM Technical Symposium on Computer Science Education V. 2},
pages = {1659–1660},
numpages = {2},
keywords = {automatic grading, database education, er diagrams, formative feedback},
location = {Pittsburgh, PA, USA},
series = {SIGCSETS 2025}
}

@inproceedings{10.1145/3745238.3745276,
author = {Zhou, Jiayi},
title = {A Dynamic Weighted Fusion-Based Hybrid XGBoost-LSTM Model for Financial Distress Prediction},
year = {2025},
isbn = {9798400712791},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3745238.3745276},
doi = {10.1145/3745238.3745276},
abstract = {Financial distress prediction (FDP) is pivotal for corporate risk management and financial ecosystem stability. Traditional methods such as the Z-Score and logistic regression are constrained by their inability to effectively address temporal dependencies and limited model interpretability. Although XGBoost excels in static feature modeling and LSTM captures temporal dynamics, their isolated implementations fail to harmonize static and temporal feature interactions. This study proposes a novel dynamically weighted fusion-based hybrid XGBoost-LSTM ensemble model to address these gaps. By integrating gradient-boosted trees for nonlinear static feature analysis and LSTM with attention mechanisms for sequential pattern mining, our model employs adaptive weight allocation via a learnable gating network, where XGBoost and LSTM contributions are dynamically assigned weights of 0.6 and 0.4, respectively. Evaluated on a Kaggle-sourced dataset of 2,836 firms with 12-quarter financial records, the model achieves a ROC AUC of 0.8809, surpassing standalone XGBoost by 2.1% and LSTM by 1.2%, with a recall of 0.9962, minimizing false negatives. Enhanced interpretability is achieved through XGBoost's feature importance ranking and LSTM's attention visualization, providing dual explanations for risk alerts. The proposed model provides a deployable solution for real-time financial monitoring systems, demonstrating practical utility in early risk detection.},
booktitle = {Proceedings of the 2nd Guangdong-Hong Kong-Macao Greater Bay Area International Conference on Digital Economy and Artificial Intelligence},
pages = {222–226},
numpages = {5},
keywords = {Dynamic Weight Allocation, Ensemble Model, Financial Distress Prediction, Interpretability, LSTM, XGBoost},
location = {
},
series = {DEAI '25}
}

@inproceedings{10.1145/3819836.3819902,
author = {Chen, Duo},
title = {Deep Learning Approach for Intelligent Finance Transformation Assessment: A BP Neural Network Model with Interpretability Analysis},
year = {2026},
isbn = {9798400722066},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3819836.3819902},
doi = {10.1145/3819836.3819902},
abstract = {Digital transformation has emerged as a critical strategic imperative for manufacturing enterprises seeking to enhance competitiveness in the Industry 4.0 era. However, existing maturity assessment methods suffer from limitations in objectivity, predictive capability, and scalability. This study proposes an integrated evaluation framework combining the Entropy-TOPSIS method with a Back Propagation (BP) neural network to address these challenges. Based on the Technology-Organization-Environment (TOE) framework and resource-based view, we develop a comprehensive four-dimensional evaluation system encompassing Technology, Organization, Personnel, and Finance dimensions, comprising 36 specific indicators. The Entropy-TOPSIS method is employed to calculate objective weights and generate maturity scores as training labels, while the BP neural network (36→20→10→1 architecture) learns complex nonlinear relationships to enable rapid predictions for new enterprises. Empirical validation using data from 225 Chinese manufacturing enterprises demonstrates that the proposed model achieves superior performance, with Mean Absolute Error (MAE) of 0.087, Root Mean Square Error (RMSE) of 0.122, and R2 of 0.893, representing significant improvements over the baseline Entropy-TOPSIS method (38.7% reduction in MAE). The neural network reduces prediction time from 245.3ms to 3.7ms, achieving a 98.5% efficiency gain suitable for large-scale real-time assessments. SHAP (SHapley Additive exPlanations) analysis restores interpretability to the black-box model, revealing that Technology Dimension indicators (particularly IoT Integration and AI/ML Adoption) exert the strongest influence on maturity scores, while feature interaction effects highlight synergies between technological infrastructure and organizational capabilities. The integrated framework successfully balances accuracy, efficiency, and transparency, providing actionable insights for enterprise managers to prioritize improvement initiatives and for policymakers to design targeted support programs. This study contributes to the digital transformation literature by bridging multi-criteria decision-making methods with machine learning approaches, offering a scalable and interpretable solution for maturity assessment in manufacturing contexts.},
booktitle = {Proceedings of the 2026 5th International Conference on Cyber Security, Artificial Intelligence and Digital Economy},
pages = {432–441},
numpages = {10},
keywords = {BP Neural Network, Digital Transformation Maturity, Entropy-TOPSIS Method, Evaluation Framework, Industry 4.0, Machine Learning, Manufacturing Enterprises, Multi-Criteria Decision Making, Predictive Modeling, SHAP Interpretability},
location = {
},
series = {CSAIDE '26}
}

@inproceedings{10.1145/2664551.2664577,
author = {Maranh{\~a}o, Guilherme Melo e and Sene J{\'u}nior, Iwens Gerv{\'a}sio and Bulc{\~a}o-Neto, Renato de Freitas},
title = {Anatomy of a Semantic Context Interpreter with Real-time Events Notification Support},
year = {2014},
isbn = {9781450332309},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/2664551.2664577},
doi = {10.1145/2664551.2664577},
abstract = {In order to deal with the complexity of context-aware applications' development, the literature has reported an increasing demand for intelligent infrastructures which process heterogeneous context information and also provide real-time distributed communication. This paper outlines the Hermes software infrastructure to supporting the development of real-time, semantic context-aware applications. The main contribution is the anatomy of the Hermes Interpreter component in which the semantics of context is kept decoupled and context changes are notified in real-time. Benefits for applications developers include a reference architecture for context interpreters as well as the reuse of a complex infrastructure providing real-time distributed context notification. We have been working on a scenario of vital signs monitoring towards validating both the infrastructure and the interpreter component.},
booktitle = {Proceedings of the 20th Brazilian Symposium on Multimedia and the Web},
pages = {159–162},
numpages = {4},
keywords = {swrl, real-time, owl, dds, context interpretation},
location = {Jo{\~a}o Pessoa, Brazil},
series = {WebMedia '14}
}

@inproceedings{10.1145/3640912.3640942,
author = {Chen, Rui and Wu, Shulin and Lin, Shaojun and Zhang, Helin and Jiang, Meiling},
title = {Design of a comprehensive management and monitoring platform for the operation and security of power information systems},
year = {2024},
isbn = {9798400716683},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3640912.3640942},
doi = {10.1145/3640912.3640942},
abstract = {In order to achieve the development goals of world-class enterprises in the new situation, it is necessary to transform the thinking of information system operation and maintenance management, and establish an efficient and real-time information operation and maintenance supervision system. This paper analyzes the information operation and maintenance management needs of power grid enterprises, and combines mainstream information equipment supervision technology architectures at home and abroad to determine the key technologies and system architecture for the development of this system. In the system design and implementation phase of this project, an object-oriented technology architecture was adopted, with Java as the development language and ORACLE as the backend database for system function development. The integration with other systems was achieved by calling XML files through JMS (Java Message Service). The B/S three-layer architecture implementation pattern effectively improved the scalability and maintainability of the system. This paper analyzes the specific functional requirements of each module and designs and implements the four main functions of the information system operation and maintenance comprehensive supervision platform. The successful implementation of the comprehensive supervision platform for information system operation and maintenance provides strong support for the normal operation of the company's business system. By establishing a stable, efficient, and flexible information system operation and maintenance management system, it effectively ensures the safe, continuous, reliable, and effective operation of information infrastructure, and provides a solid foundation for achieving the company's strategic goals.},
booktitle = {Proceedings of the 2023 International Conference on Communication Network and Machine Learning},
pages = {151–155},
numpages = {5},
location = {Zhengzhou, China},
series = {CNML '23}
}

@inproceedings{10.1145/3803437.3804876,
author = {Dai, Hanzheng},
title = {Automated Diagnosis and Testing of Game Compatibility Layers},
year = {2026},
isbn = {9798400726361},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803437.3804876},
doi = {10.1145/3803437.3804876},
abstract = {This doctoral research proposal focuses on a critical yet under-explored problem: how to automatically diagnose and test game compatibility layers (GCLs). GCLs are software systems composed of multiple subcomponents that allow unmodified games to run across different platforms by translating system calls and APIs in real time. In 2025, the number of Linux gaming users increased by 57%, reaching over four million monthly active users. As most commercial games are developed primarily for Windows, Linux users increasingly rely on GCLs to run Windows games on Linux, indicating a rapidly expanding user base for GCLs. However, localizing GCLs' bugs heavily relies on unexpected behavior reported by the gamers (who usually have limited background in programming), thus taking maintainers' extra effort to diagnose and fix bugs.It motivates this doctoral research, aiming to analyze the symptoms, and propose methods to identify bug-related subcomponents within GCLs and further test GCLs. Specifically, I design the following three work packages. 1) An empirical study on GCL's issue reports to build a taxonomy of the unique symptoms in GCLs and uncover relationships between symptoms and GCL's subcomponents; 2) A language model-based framework to help maintainers to accurately identify related subcomponents given user-reported symptoms; and 3) A symptom-guided testing method to uncover more bugs in GCLs and improve the system quality.},
booktitle = {Proceedings of the 34th ACM International Conference on the Foundations of Software Engineering},
pages = {41–42},
numpages = {2},
keywords = {game compatibility layers, proton, empirical software engineering, large language models, program diagnosis, software maintenance},
location = {Concordia University, Montreal, QC, Canada},
series = {FSE Companion '26}
}

@inproceedings{10.1145/3777730.3777753,
author = {Yuan, Siman and Mu, Peining and Zhao, Yuguang and Li, Honghe and Yuan, Zishu and Mo, Yidan},
title = {Multimodal Interaction Design in Music Therapy: From Theoretical Framework to Clinical Translation},
year = {2026},
isbn = {9798400718540},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777730.3777753},
doi = {10.1145/3777730.3777753},
abstract = {Music therapy has evolved from an empirical intervention to an evidence-based practice and is demonstrating broad translational potential in neuroscience and rehabilitation medicine. This study presents an end-to-end multimodal music-therapy framework that integrates electroencephalography (EEG), movement feedback, and musical signals. A CNN–GRU–Attention architecture is employed for low-latency feature extraction and cross-modal alignment, while Time-Sensitive Networking (TSN) and Iterative Dynamic Programming (IDP) are leveraged to optimize edge-side real-time inference. A neural-plasticity integral model is formulated to quantify the mechanisms by which musical stimuli regulate cerebral oscillations and drive synaptic remodeling. In a multicenter randomized controlled trial (RCT, n = 82), the music-based intervention significantly improved social responsiveness (Cohen's d = 1.12, p &lt; 0.001) and reduced anxiety in children with autism spectrum disorder; a subsequent meta-analysis corroborated its efficacy across multiple indications. These findings delineate a systematic pathway for the theoretical modeling, technical implementation, and clinical translation of multimodal music therapy, thereby advancing the development of rehabilitation medicine and digital therapeutics.},
booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {133–138},
numpages = {6},
keywords = {CNN–GRU–Attention Architecture, Clinical Translation, Cross-modal Alignment, Multimodal Music Therapy, Neuroplasticity Integral Model},
location = {
},
series = {AIVRID '25}
}

