@inproceedings{10.1145/949344.949443,
author = {Bollella, Greg and Canham, Tim and Carson, Vanessa and Champlin, Virgil and Dvorak, Daniel and Giovannoni, Brian and Indictor, Mark and Meyer, Kenny and Murray, Alex and Reinholtz, Kirk},
title = {Programming with non-heap memory in the real time specification for Java},
year = {2003},
isbn = {1581137516},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/949344.949443},
doi = {10.1145/949344.949443},
abstract = {The Real-Time Specification for Java (RTSJ) provides facilities for deterministic, real-time execution in a language that is otherwise subject to variable latencies in memory allocation and garbage collection. A major consequence of these facilities is that the normal Java practice of passing around references to objects in heap memory cannot be used in hard real-time activities. Instead, designers must think carefully about what type of non-heap memory to use and how to transfer data between components without violating RTSJ's memory-area assignment rules. This report explores the issues of programming with non-heap memory from a practitioner's view in designing and programming real-time control loops using a commercially available implementation of the RTSJ.},
booktitle = {Companion of the 18th Annual ACM SIGPLAN Conference on Object-Oriented Programming, Systems, Languages, and Applications},
pages = {361–369},
numpages = {9},
keywords = {architecture, programming model, scoped memory},
location = {Anaheim, CA, USA},
series = {OOPSLA '03}
}

@inproceedings{10.1145/3799825.3818755,
author = {Askari, Farshad and Wen, Shiyun and Tao, Jian and Surabhi, Praneet and Yan, Wei},
title = {From State Reconstruction to State Interpretation: S2VMO, an Agentic Voxel-Based Digital Twin for Space Habitat Structural Monitoring},
year = {2026},
isbn = {9798400725487},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3799825.3818755},
doi = {10.1145/3799825.3818755},
abstract = {Digital twins for space structures can estimate the physical states of systems with real-time data, yet long-term understanding and consistent analysis remain difficult. Current digital twin systems primarily aggregate data for monitoring and simulation, but they require experts to extract further insight, and most focus on state reconstruction and visualization, offering limited support for interpretation and decision-making. This study introduces the S2VMO (Sensor-to-Voxel Multi-Agentic Observatory), a framework that reconstructs structural state through finite element modeling (FEM) from four strain sensors by a two-stage neural surrogate that is stored as a graph of spatially indexed voxels. The shared voxel world model enables agents to identify anomalies, explain structural behavior, and provide inspection-oriented recommendations through natural-language interaction. This extends digital twins beyond passive monitoring toward explainable structural assessment and decision support for future space habitat operations.},
booktitle = {Proceedings of the Special Interest Group on Computer Graphics and Interactive Techniques Conference Posters},
articleno = {21},
numpages = {3},
location = {
},
series = {SIGGRAPH Posters '26}
}

@inproceedings{10.1145/3544548.3581076,
author = {Wang, Yiwen and Li, Ziming and Chelladurai, Pratheep Kumar and Dannels, Wendy and Oh, Tae and Peiris, Roshan L},
title = {Haptic-Captioning: Using Audio-Haptic Interfaces to Enhance Speaker Indication in Real-Time Captions for Deaf and Hard-of-Hearing Viewers},
year = {2023},
isbn = {9781450394215},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3544548.3581076},
doi = {10.1145/3544548.3581076},
abstract = {Captions make the audio content of videos accessible and understandable for deaf or hard-of-hearing people (DHH). However, in real-time captioning scenarios, captions alone can be challenging for DHH users to identify the active speaker in a real time in multiple-speaker scenarios. To enhance the accessibility of real-time captioning, we propose Haptic-Captioning which provides real-time vibration feedback on the wrist by directly translating the sound of content into vibrations. We conducted three experiments to examine: (1) the haptic perception (Preliminary Study), (2) the feasibility of the haptic modality along with real-time and non-real-time visual captioning methods (Study 1), and (3) the user experience of using the Haptic-Captioning system in different media contexts (Study 2). Our results highlight that the Haptic-Captioning complements visual captions by improving caption readability, maintaining media engagement, enhancing understanding of emotions, and assisting speaker indication in real-time captioning scenarios. Furthermore, we discuss design implications for the future development of Haptic-Captioning.},
booktitle = {Proceedings of the 2023 CHI Conference on Human Factors in Computing Systems},
articleno = {781},
numpages = {14},
keywords = {Haptics, accessibility, captioning, deaf and hard of hearing},
location = {Hamburg, Germany},
series = {CHI '23}
}

@proceedings{10.1145/1167999,
title = {JTRES '06: Proceedings of the 4th international workshop on Java technologies for real-time and embedded systems},
year = {2006},
isbn = {1595935444},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {Over 90 percent of all microprocessors are now used for real-time and embedded applications, and the behavior of many of these applications is constrained by the physical world. Higher-level programming languages and middleware are needed to robustly and productively design, implement, compose, integrate, validate, and enforce real-time constraints along with conventional functional requirements and reusable components.Designing real-time and embedded systems that implement their required capabilities, are dependable and predictable, and are parsimonious in their use of limited computing resources is hard; building them on time and within budget is even harder. Moreover, due to global competition for marketshare and engineering talent, companies are now also faced with the problem of developing and delivering new products in short time frames. It is therefore essential that the production of real-time embedded systems can take advantage of languages, tools, and methods that enable higher software productivity.Ideally, developers should use programming languages that shield them from many accidental complexities, such as type errors, memory management, and steep learning curves. The Java programming language has become an attractive choice because of its safety, productivity, its relatively low maintenance costs, and the availability of well trained developers.Although it has good software engineering characteristics, Java is unsuitable for developing realtime embedded systems, mainly due to under-specification of thread scheduling and the presence of garbage collection. Recently, to address these problems, a number of extension to Java have been proposed, the two most representative being the Experts Group Real-Time Specification (RTSJ) for Java and the J-Consortium Real-Time Core Extension (RTCore). The intent of these specifications is the development of real-time applications by providing several additions such as extending the Java memory model, providing stronger semantics in thread scheduling, and so on.There is growing interest in Real-Time Java in both the research community and industry, because of its challenges and its potential impact on the development of embedded and real-time applications. The goal of this workshop is to gather researchers working on real-time and embedded Java to identify the challenging problems that still need to be properly solved in order to assure the success of Real-Time Java as a technology, and to report results and experience gained by researchers. Topics of interest to the workshop include, but are not limited to:•New real-time programming paradigms and language features•Industrial experience and practitioner reports•Real-time design patterns and programming idioms•Formal models of real-time computation•Extensions to RTSJ•Virtual machines and execution environments•Memory management and real-time garbage collection•Compiler analysis and implementation techniques•Distributed Real-Time Java and Java-based distributed real-time middleware•Scheduling frameworks, feasibility analysis, and timing analysis•High-integrity and safety critical system support•Java-based real-time operating systems and processors},
location = {Paris, France}
}

@inproceedings{10.1145/3809986.3810101,
author = {Zhao, Lijun},
title = {WPD-PyrSENet: A Wavelet Packet Decomposition-Based Pyramid Squeeze-and-Excitation Network for Automated EEG Seizure Detection},
year = {2026},
isbn = {9798400721946},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3809986.3810101},
doi = {10.1145/3809986.3810101},
abstract = {Epilepsy is a chronic neurological disorder, and electroencephalogram (EEG), as a widely used electrophysiological monitoring technique, offers the advantages of being non-invasive, cost-effective, and high-resolution. It directly reflects abnormal neuronal discharges in the brain, serving as a core basis for epilepsy diagnosis. However, traditional EEG signal analysis relies on manual interpretation, which suffers from low efficiency, strong subjectivity, high rates of missed and false detections, making it difficult to meet the demands of large-scale clinical screening and real-time monitoring. To address these issues, this paper proposes an automated detection method based on a Wavelet Packet Decomposition-based Pyramid Squeeze-and-Excitation Network (WPD-PyrSENet). Firstly, three-level wavelet packet decomposition is applied to the EEG signal, extracting approximate entropy, sample entropy, and standard deviation from the eight sub-bands to construct a multi-scale feature vector. Secondly, a pyramid-structured one-dimensional convolutional neural network is designed, achieving hierarchical feature extraction through convolutional layers with progressively decreasing channel numbers, while a Squeeze-and-Excitation (SE) attention mechanism is introduced to enhance the expression of key features. Finally, a fully connected layer combined with a Softmax function is used for automatic classification between healthy states and epileptic seizure periods. Experimental results based on ten-fold stratified cross-validation on the Bonn dataset and the UCI Epileptic Seizure Recognition dataset show that the proposed method achieves an accuracy of 99.00%, sensitivity of 99.00%, and specificity of 100.00% on the Bonn dataset, and 99.20%, 75.52%, and 96.57% respectively on the UCI dataset. The study demonstrates that the proposed method possesses high detection accuracy and good generalization capability, providing technical support for clinical auxiliary diagnosis and real-time monitoring of epilepsy.},
booktitle = {Proceedings of the 2026 6th International Conference on Bioinformatics and Intelligent Computing},
pages = {735–741},
numpages = {7},
keywords = {CNN, Wave Packet Decomposition, epileptic EEG},
location = {
},
series = {BIC '26}
}

@inproceedings{10.1145/3819836.3819975,
author = {Cao, Jiqing and Zhao, Xiaoyu},
title = {Construction method of knowledge enhanced industrial-LLM for intelligent manufacturing operation and maintenance},
year = {2026},
isbn = {9798400722066},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3819836.3819975},
doi = {10.1145/3819836.3819975},
abstract = {In response to the limitations of general retrieval-augmented generation (RAG) methods in handling term ambiguity and multi-hop causal reasoning in industrial scenarios, this paper proposes a knowledge-enhanced industrial large language model construction method for intelligent manufacturing operation and maintenance. It integrates knowledge graph entity alignment with RAG to enable dynamic knowledge recall, and employs low-rank adaptation for efficient fine-tuning using multi-source heterogeneous operation and maintenance data. The method also incorporates a constraint decoding mechanism based on real-time knowledge graph verification to suppress hallucinations and ensure output interpretability. Experimental results demonstrate significant improvements in fault diagnosis accuracy and maintenance plan generation quality compared to baseline models.},
booktitle = {Proceedings of the 2026 5th International Conference on Cyber Security, Artificial Intelligence and Digital Economy},
pages = {932–937},
numpages = {6},
keywords = {Industrial-LLM, Intelligent manufacturing operation and maintenance, Knowledge graph, Low rank adaptation, Search enhanced generation},
location = {
},
series = {CSAIDE '26}
}

@inproceedings{10.1145/3777577.3777718,
author = {Zhao, Yulong and Wang, Jiangbo and Wang, Qiwen and Li, Mengjie},
title = {Construction and performance analysis of a generative adversarial network (GAN) model for sports rehabilitation movement trajectory optimization},
year = {2026},
isbn = {9798400715112},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777577.3777718},
doi = {10.1145/3777577.3777718},
abstract = {To address the issues of insufficient physiological constraints, weak individual adaptability, and low precision in movement trajectory generation for sports rehabilitation, a physiologically constrained enhanced generative adversarial network (RehabGAN) model is proposed. This model innovatively designs a "physiologically constrained enhanced generator" that embeds two core modules—a range of motion (ROM) constraint module and a dynamic time warping (DTW) similarity feedback module—to simultaneously ensure physiological realism (via real-time correction of out-of-bounds trajectory points) and alignment with standard templates (via similarity optimization). Furthermore, a multi-task discriminator is constructed to jointly optimize trajectory authenticity, physiological compliance, and rehabilitation adaptability. Experiments on a dataset of 10 upper limb rehabilitation movements from 200 subjects (120 stroke patients and 80 healthy individuals) showed that: the root mean square error (RMSE) of RehabGAN-generated trajectories was 1.23 mm (32.4% lower than traditional GAN and 42.8% lower than CNN-LSTM); the physiological constraint satisfaction rate reached 98.7% (significantly higher than traditional GAN's 76.3%); single-segment trajectory generation took 0.32 seconds (meeting clinical real-time requirements); and three rehabilitation therapists gave the model a blind evaluation score of 4.72/5.0 for rehabilitation fit (outperforming traditional methods). These metrics—lowered RMSE, high physiological constraint compliance, real-time generation, and strong therapist endorsement—translate to smoother, safer trajectories that minimize secondary injury risks (e.g., joint strain) and improve patient adherence to training, directly supporting better rehabilitation outcomes. The established "objective indicator + subjective blind evaluation" quantitative system provides a reference for validating rehabilitation trajectory models. The model can effectively support precision and adaptive stroke rehabilitation training, enabling personalized therapy customization for patients with varying motor impairments. However, the current dataset is limited to upper limb movements, and future work will expand to full-body rehabilitation scenarios.},
booktitle = {Proceedings of the 2025 6th International Symposium on Artificial Intelligence for Medical Sciences},
pages = {869–875},
numpages = {7},
keywords = {Motor rehabilitation, generative adversarial network (GAN), RehabGAN model, movement trajectory optimization, physiological constraints, stroke rehabilitation, trajectory error analysis},
location = {
},
series = {ISAIMS '25}
}

@inproceedings{10.1145/3757369.3767613,
author = {Naseck, Perry and Blanchard, Lancelot and Lavakare, Madhav and Lecamwasam, Kimaya and Paradiso, Joseph A.},
title = {Physical Manifestation of Generative AI Music Systems for Live Performance},
year = {2025},
isbn = {9798400721298},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3757369.3767613},
doi = {10.1145/3757369.3767613},
abstract = {This paper explores the physical manifestation of generative AI music systems for live performance, focusing on bridging the expressive gap between AI-generated music and audience perception. Through a year-long collaboration with a human performer, we constructed a kinetic sculpture that visualizes the outputs of an AI jam_bot during concerts. The sculpture, powered by ML-based and pattern-driven mapping methodologies, interprets real-time AI musical decisions as expressive movements. Audience feedback indicates increased engagement and curiosity, although interpretability remains a challenge. Our work highlights the potential of embodied visualization to establish communicative presence for AI performers and suggests avenues for future research.},
